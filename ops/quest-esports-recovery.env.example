# Copy this file outside the repository on an isolated recovery host, fill it there, and chmod 600.
# This is the normal production restore contract. Run disposable rehearsals
# through the rehearsal wrapper, which supplies its explicit command-line test
# seam; never put fixture switches in this file.
POSTGRES17_BIN=/usr/lib/postgresql/17/bin
POSTGRES_CA_FILE=/etc/quest-esports/tls/quest-private-ca.crt
POSTGRES_CERT_FILE=/etc/quest-esports/tls/quest-postgres.crt
POSTGRES_KEY_FILE=/etc/quest-esports/tls/quest-postgres.key
DIRECT_URL=postgresql://quest_migrator:REPLACE_ME@127.0.0.1:55432/quest
RESTORE_TARGET_HOST=127.0.0.1
RESTORE_TARGET_PORT=55432
RESTORE_TARGET_DATABASE=quest
RESTORE_TARGET_MAJOR=17
RESTORE_TARGET_DATA_ROOT=/srv/quest-esports/postgres/17/data
RESTORE_TARGET_SENTINEL_COMMAND=/usr/local/sbin/quest-release-postgres-target
RESTORE_PRODUCTION_AUTHORIZED=1
UPLOAD_ROOT=/srv/quest-esports/uploads
PRIVATE_UPLOAD_ROOT=/srv/quest-esports/private
# Keep this private identity offline and mount/copy it only to the isolated recovery host when needed.
BACKUP_AGE_IDENTITY_FILE=/secure/recovery/quest-esports-production-age-identity.txt
