# Copy this file outside the repository on an isolated recovery host, fill it there, and chmod 600.
# DIRECT_URL must point to the explicitly approved recovery target. Never use Paris production for a drill.
PATH=/usr/lib/postgresql/17/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
DIRECT_URL=postgresql://quest_restore:REPLACE_ME@127.0.0.1:5432/quest_restore
# These must be new, empty, absolute recovery-host directories with different base names.
UPLOAD_ROOT=/srv/quest-recovery/uploads
PRIVATE_UPLOAD_ROOT=/srv/quest-recovery/private
# Keep this private identity offline and mount/copy it only to the isolated recovery host when needed.
BACKUP_AGE_IDENTITY_FILE=/secure/recovery/quest-esports-production-age-identity.txt
