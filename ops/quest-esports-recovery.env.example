# Copy this file outside the repository on an isolated recovery host, fill it there, and chmod 600.
# DIRECT_URL must point to the explicitly approved disposable recovery target.
# Never use Paris production or the legacy PostgreSQL 16 port for a drill.
POSTGRES17_BIN=/usr/lib/postgresql/17/bin
POSTGRES_CA_FILE=/secure/recovery/quest-private-ca.crt
DIRECT_URL=postgresql://quest_migrator:REPLACE_ME@127.0.0.1:55432/quest_restore?sslmode=verify-full
RESTORE_TARGET_HOST=127.0.0.1
RESTORE_TARGET_PORT=55432
RESTORE_TARGET_DATABASE=quest_restore
RESTORE_TARGET_MAJOR=17
RESTORE_TARGET_SENTINEL_FILE=/secure/recovery/quest-rehearsal-target.env
QUEST_RUNTIME_DATABASE_URL=postgresql://quest_runtime:REPLACE_ME@127.0.0.1:55432/quest_restore?sslmode=verify-full
# These must be roots below one unique, previously absent recovery-host parent;
# the rehearsal creates that parent and both roots atomically.
UPLOAD_ROOT=/srv/quest-rehearsal-UNIQUE/public
PRIVATE_UPLOAD_ROOT=/srv/quest-rehearsal-UNIQUE/private
# Keep this private identity offline and mount/copy it only to the isolated recovery host when needed.
BACKUP_AGE_IDENTITY_FILE=/secure/recovery/quest-esports-production-age-identity.txt
