[Unit]
Description=Check Quest Esports production backup freshness
After=quest-esports-backup.service
OnFailure=quest-esports-backup-failure@%n.service

[Service]
Type=oneshot
User=deploy
Group=deploy
# Keep the freshness check on the same root:deploy 0750 directory. The
# root:deploy 0640 backup-client-ca.crt trust bundle contains the PostgreSQL
# server issuer; the client certificate/key remain separate identity material.
Environment=BACKUP_ENV_FILE=/etc/quest-esports-backup.env
WorkingDirectory=/var/www/QuestEsports
ExecStartPre=/usr/bin/test -d /var/www/QuestEsports
ExecStartPre=/usr/bin/test -r /var/www/QuestEsports/ops/check-backup-freshness.sh
ExecStart=/usr/bin/bash /var/www/QuestEsports/ops/check-backup-freshness.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/quest-esports /var/lock/quest-esports-release.lock
RestrictSUIDSGID=true
