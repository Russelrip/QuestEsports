[Unit]
Description=Quest Esports encrypted production backup
After=network-online.target docker.service
Wants=network-online.target docker.service
OnFailure=quest-esports-backup-failure@%n.service

[Service]
Type=oneshot
User=deploy
Group=deploy
# /etc/quest-esports-backup is root:deploy 0750. backup-client-ca.crt is a
# root:deploy 0640 trust bundle containing the issuer of quest-postgres.crt;
# backup-client.{crt,key} are separate root:deploy 0640 client identity files.
# Deploy is the only non-root identity permitted to traverse/read this material.
# Server TLS remains under /etc/quest-esports/tls for the UID999 PostgreSQL
# container contract.
# The deploy service identity must be able to access the Docker socket so the
# script can launch its locked-down PostgreSQL client on quest-shared.
Environment=BACKUP_ENV_FILE=/etc/quest-esports-backup.env
Environment=POSTGRES_CA_FILE=/etc/quest-esports-backup/backup-client-ca.crt
Environment=BACKUP_CLIENT_TLS_DIR=/etc/quest-esports-backup
Environment=BACKUP_CLIENT_CERT_FILE=/etc/quest-esports-backup/backup-client.crt
Environment=BACKUP_CLIENT_KEY_FILE=/etc/quest-esports-backup/backup-client.key
WorkingDirectory=/var/www/QuestEsports
ExecStartPre=/usr/bin/test -d /var/www/QuestEsports
ExecStartPre=/usr/bin/test -r /var/www/QuestEsports/ops/backup-production.sh
ExecStart=/usr/bin/bash /var/www/QuestEsports/ops/backup-production.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/quest-esports /var/lock/quest-esports-release.lock
