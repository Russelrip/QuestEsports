[Unit]
Description=Refresh the Cloudflare real-IP ranges trusted by Nginx
Documentation=https://www.cloudflare.com/ips/
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/quest-cloudflare-real-ip-refresh
# The script writes one file under /etc/nginx and reloads Nginx. Nothing else
# on the host is writable to it.
ProtectSystem=full
ReadWritePaths=/etc/nginx
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
