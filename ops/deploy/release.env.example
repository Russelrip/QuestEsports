# Install as /etc/quest-esports/release.env, root:root, mode 0600 or 0640.
# Every command below is a root-owned executable wrapper. It must not echo
# credentials, URLs containing credentials, or secret environment contents.
RELEASE_ROOT=/opt/quest-esports
RELEASES_ROOT=/opt/quest-esports/releases
CURRENT_LINK=/opt/quest-esports/current
RELEASE_LOCK_PATH=/var/lock/quest-esports-release.lock
RELEASE_ENVIRONMENT=production
RELEASE_ENVIRONMENT_PROTECTED=1
QUEST_COMPOSE_TEMPLATE=/var/www/QuestEsports/ops/docker/compose.production.yml
VALORANT_COMPOSE_SOURCE=/var/www/valorant-platform-backend/docker-compose.production.yml
DOCKER_BIN=/usr/bin/docker
CURRENT_SUPABASE_ENV_FILE=/etc/quest-esports/current-supabase.env
QUEST_RUNTIME_ENV_FILE=/etc/quest-esports/quest.production.env
VALORANT_RUNTIME_ENV_FILE=/etc/quest-esports/valorant.production.env
VALORANT_RUNTIME_CA_HOST_FILE=/etc/quest-esports/tls/quest-private-ca.crt
VALORANT_RUNTIME_COMPOSE_CONTRACT=/var/www/QuestEsports/ops/docker/valorant.production.compose.yml
QUEST_ADOPTION_COMPOSE_OVERLAY=/var/www/QuestEsports/ops/docker/compose.adoption-candidate.yml
VALORANT_ADOPTION_COMPOSE_OVERLAY=/var/www/QuestEsports/ops/docker/valorant.adoption-candidate.yml
# These protected files contain credentials managed out of band. They are
# passed only to one-shot migrator/security commands, never to backend
# runtime containers. The files themselves must be root-owned and mode 0600.
RECOVERY_ADMIN_URL_FILE=/etc/quest-esports/secrets/recovery-admin-url
QUEST_MIGRATOR_DATABASE_URL_FILE=/etc/quest-esports/secrets/quest-migrator-url
VALORANT_MIGRATOR_DATABASE_URL_FILE=/etc/quest-esports/secrets/valorant-migrator-url
CUTOVER_RESTORE_COMMAND=/usr/local/sbin/quest-cutover-restore-postgres17
CUTOVER_ABORT_COMMAND=/usr/local/sbin/quest-cutover-abort-target
# This is used only by the pre-writer recovery path if either URL switch has
# started. It must restore the backed-up Supabase URL set and return `restored`;
# post-commit recovery never invokes it.
CUTOVER_SUPABASE_URL_RESTORE_COMMAND=/usr/local/sbin/quest-cutover-restore-supabase-urls
# The release/cutover wrappers invoke this only with a protected recovery URL
# and either the private Compose target (quest-postgres:5432) or the staged
# loopback target (127.0.0.1:55432). The verifier must refuse 127.0.0.1:5432
# (the retained PostgreSQL 16 cluster) and return only `security-verified`.
SECURITY_VERIFY_COMMAND=/usr/local/sbin/quest-release-post-restore-security-verify
POSTGRES_TARGET_HOST=127.0.0.1
POSTGRES_TARGET_PORT=55432
POSTGRES_TARGET_DATABASE=quest
POSTGRES_TARGET_MAJOR=17
POSTGRES_TARGET_DATA_ROOT=/srv/quest-esports/postgres/17/data
POSTGRES_TARGET_SENTINEL_COMMAND=/usr/local/sbin/quest-release-postgres-target

# Host/artifact trust boundary. The wrapper must call validate-host.sh with
# RELEASE_MANIFEST and return only `validated` on success. Cosign identity and
# issuer are intentionally deployment-owned values, not repository secrets.
VALIDATE_HOST_COMMAND=/usr/local/sbin/quest-release-validate-host
COSIGN_BIN=/usr/local/bin/cosign
# Cosign is used only for Quest-owned release images. The official PostgreSQL
# image and sibling VALORANT image use exact owner-approved digest equality;
# neither is passed to the Quest OIDC verifier.
# This must remain the exact certificate identity of the repository's image
# workflow; do not broaden it to a repository-wide or organization-wide match.
QUEST_COSIGN_CERTIFICATE_IDENTITY_REGEXP='^https://github\.com/Russelrip/QuestEsports/\.github/workflows/build-container-images\.yml@refs/heads/main$'
QUEST_COSIGN_OIDC_ISSUER=https://token.actions.githubusercontent.com
QUEST_FRONTEND_IMAGE_APPROVED_REF=
QUEST_BACKEND_IMAGE_APPROVED_REF=
MIGRATOR_IMAGE_APPROVED_REF=
POSTGRES_IMAGE_APPROVED_REF=postgres:17-bookworm@sha256:051f7b7b3abdd564d5d1bd1e8c4b9c1b6e77087d1dd22020ede611c096a272e0
VALORANT_IMAGE_APPROVED_REF=
SERVICE_OWNERSHIP_COMMAND=/usr/local/sbin/quest-release-service-ownership

# These checks return exactly the values documented by release.sh: migration
# status wrappers return `none|pending target=quest-postgres schema=<public|valorant>
# repository=<quest|valorant>`; migrator wrappers return `migrated
# image=<exact manifest migrator digest> target=quest-postgres schema=<public|valorant>
# repository=<quest|valorant>`. Service ownership returns exactly two records:
# `file=/etc/quest-esports/release.env service=<quest-prod|valorant-prod>
# owner=root mode=<0600|0640> observed_at=<UTC>`. Commands are
# root-owned wrappers and must never echo credentials, URLs, or environment
# contents. Backup evidence must return one line exactly in this form (with the
# requested full SHA):
# verified-complete release_sha=<sha> schemas=verified:public,valorant uploads=verified:public,private archive=verified checksum=verified remote=verified
DATABASE_HEALTH_COMMAND=/usr/local/sbin/quest-release-database-health
DATABASE_READINESS_COMMAND=/usr/local/sbin/quest-release-database-ready
REGISTRY_CHECK_COMMAND=/usr/local/sbin/quest-release-registry-check
BACKUP_FRESHNESS_COMMAND=/var/www/QuestEsports/ops/check-backup-freshness.sh
BACKUP_COMMAND=/var/www/QuestEsports/ops/backup-production.sh
BACKUP_EVIDENCE_COMMAND=/usr/local/sbin/quest-release-backup-evidence
BACKUP_ENV_FILE=/etc/quest-esports-backup.env

QUEST_MIGRATION_STATUS_COMMAND=/usr/local/sbin/quest-release-quest-migration-status
VALORANT_MIGRATION_STATUS_COMMAND=/usr/local/sbin/quest-release-valorant-migration-status
QUEST_MIGRATOR_COMMAND=/usr/local/sbin/quest-release-quest-migrate
VALORANT_MIGRATOR_COMMAND=/usr/local/sbin/quest-release-valorant-migrate
QUEST_MIGRATION_OWNER_APPROVAL_SHA=
VALORANT_MIGRATION_OWNER_APPROVAL_SHA=
BACKUP_APPROVAL=
FIRST_CUTOVER_OWNER_APPROVAL_SHA=

# One-time adoption of the already-authoritative VPS PostgreSQL 17 service into
# Compose. These commands are distinct from the historical Supabase cutover and
# from steady-state release.sh. Every wrapper is root-owned, non-symlinked, and
# returns only the exact acknowledgement enforced by adopt-compose.sh.
FIRST_COMPOSE_ADOPTION_OWNER_APPROVAL_SHA=
ADOPTION_HOST_VALIDATE_COMMAND=/usr/local/sbin/quest-adoption-validate-host
ADOPTION_AUTHORITY_AUDIT_COMMAND=/usr/local/sbin/quest-adoption-audit-authority
ADOPTION_RECOVERY_VERIFY_COMMAND=/usr/local/sbin/quest-adoption-verify-recovery
ADOPTION_CANDIDATE_VALIDATE_COMMAND=/usr/local/sbin/quest-adoption-validate-candidate
ADOPTION_HANDOFF_ARM_COMMAND=/usr/local/sbin/quest-adoption-arm-handoff
ADOPTION_FREEZE_COMMAND=/usr/local/sbin/quest-adoption-freeze-writers
ADOPTION_LEGACY_STOP_COMMAND=/usr/local/sbin/quest-adoption-stop-legacy
ADOPTION_FINAL_BACKUP_COMMAND=/usr/local/sbin/quest-adoption-final-backup
ADOPTION_FINAL_RESTORE_COMMAND=/usr/local/sbin/quest-adoption-final-restore
ADOPTION_COMPOSE_FROZEN_START_COMMAND=/usr/local/sbin/quest-adoption-start-compose-frozen
ADOPTION_QUEST_WRITER_ENABLE_COMMAND=/usr/local/sbin/quest-adoption-enable-quest
ADOPTION_VALORANT_WRITER_ENABLE_COMMAND=/usr/local/sbin/quest-adoption-enable-valorant
ADOPTION_COMMIT_VERIFY_COMMAND=/usr/local/sbin/quest-adoption-verify-commit
ADOPTION_LEGACY_MASK_COMMAND=/usr/local/sbin/quest-adoption-mask-legacy
ADOPTION_PRECOMMIT_ROLLBACK_COMMAND=/usr/local/sbin/quest-adoption-precommit-rollback
ADOPTION_POSTCOMMIT_FREEZE_COMMAND=/usr/local/sbin/quest-adoption-postcommit-freeze

# State wrappers return one line per expected unit, for example:
# unit=valorant-platform state=inactive observed_at=20260828T120000Z
# Reboot-persistence wrappers return the same unit set with
# `state=inactive reboot_persistent=true observed_at=<UTC>`.
OLD_VALORANT_UNITS=valorant-platform,valorant-updater,valorant-discord-bot
OLD_QUEST_UNITS=quest-pm2
OLD_VALORANT_ACTIVE_CHECK=/usr/local/sbin/quest-release-old-valorant-active
OLD_VALORANT_STOP_COMMAND=/usr/local/sbin/quest-release-old-valorant-stop
OLD_VALORANT_RESTART_COMMAND=/usr/local/sbin/quest-release-old-valorant-restart
OLD_VALORANT_MASK_COMMAND=/usr/local/sbin/quest-release-old-valorant-mask
OLD_VALORANT_UNMASKED_CHECK=/usr/local/sbin/quest-release-old-valorant-unmasked
OLD_VALORANT_REBOOT_PERSISTENCE_CHECK=/usr/local/sbin/quest-release-old-valorant-reboot-persistence
OLD_QUEST_STOP_COMMAND=/usr/local/sbin/quest-release-old-quest-stop
OLD_QUEST_RESTART_COMMAND=/usr/local/sbin/quest-release-old-quest-restart
OLD_QUEST_ACTIVE_CHECK=/usr/local/sbin/quest-release-old-quest-active
OLD_QUEST_REBOOT_PERSISTENCE_CHECK=/usr/local/sbin/quest-release-old-quest-reboot-persistence
OLD_QUEST_MASK_COMMAND=/usr/local/sbin/quest-release-old-quest-mask
OLD_QUEST_UNMASKED_CHECK=/usr/local/sbin/quest-release-old-quest-unmasked
OLD_DATABASE_AUTHORITATIVE_COMMAND=/usr/local/sbin/quest-release-old-database-authoritative
# Return supabase for the legacy PM2 application or quest-postgres for an
# existing Compose release. The rollback path never starts a Compose bundle
# while the legacy Supabase application is authoritative.
OLD_APPLICATION_RESTART_COMMAND=/usr/local/sbin/quest-release-old-application-restart
QUEST_FREEZE_ENABLE_COMMAND=/usr/local/sbin/quest-release-quest-freeze-enable
VALORANT_FREEZE_ENABLE_COMMAND=/usr/local/sbin/quest-release-valorant-freeze-enable
QUEST_FREEZE_DISABLE_COMMAND=/usr/local/sbin/quest-release-quest-freeze-disable
VALORANT_FREEZE_DISABLE_COMMAND=/usr/local/sbin/quest-release-valorant-freeze-disable
QUEST_FREEZE_STATUS_COMMAND=/usr/local/sbin/quest-release-quest-freeze-status
VALORANT_FREEZE_STATUS_COMMAND=/usr/local/sbin/quest-release-valorant-freeze-status
QUEST_HEALTH_URL=http://127.0.0.1:5001/api/health/live
QUEST_READINESS_URL=http://127.0.0.1:5001/api/health/ready
VALORANT_HEALTH_URL=https://valorant-platform:8000/api/v1/health
VALORANT_CA_FILE=/etc/quest-esports/tls/quest-private-ca.crt
CURL_BIN=/usr/bin/curl
# This root-owned wrapper executes curl from the Quest backend container on
# quest-shared; the host must never resolve valorant-platform itself.
VALORANT_CONTAINER_HEALTH_COMMAND=/usr/local/sbin/quest-release-valorant-health
QUEST_READINESS_ACK_COMMAND=/usr/local/sbin/quest-release-quest-ready
VALORANT_READINESS_ACK_COMMAND=/usr/local/sbin/quest-release-valorant-ready
# First cutover switches each writer group's URL set independently from its
# own protected runtime environment, then restarts each service independently.
# Both effective URL checks and both acknowledgements are mandatory.
QUEST_DATABASE_URL_SWITCH_COMMAND=/usr/local/sbin/quest-cutover-switch-quest-url
VALORANT_DATABASE_URL_SWITCH_COMMAND=/usr/local/sbin/quest-cutover-switch-valorant-url
QUEST_DATABASE_URL_EFFECTIVE_COMMAND=/usr/local/sbin/quest-cutover-verify-quest-url
VALORANT_DATABASE_URL_EFFECTIVE_COMMAND=/usr/local/sbin/quest-cutover-verify-valorant-url
QUEST_SERVICE_RESTART_COMMAND=/usr/local/sbin/quest-release-quest-restart
VALORANT_SERVICE_RESTART_COMMAND=/usr/local/sbin/quest-release-valorant-restart
# These wrappers independently start one candidate in frozen/read-only mode
# and return `started-frozen-read-only group=<quest|valorant>`.
QUEST_CANDIDATE_FROZEN_START_COMMAND=/usr/local/sbin/quest-release-quest-candidate-start
VALORANT_CANDIDATE_FROZEN_START_COMMAND=/usr/local/sbin/quest-release-valorant-candidate-start
CANDIDATE_START_CONTRACT=frozen-read-only
CANDIDATE_FREEZE_FLAG=--write-freeze=validation
CANDIDATE_READ_ONLY_FLAG=--read-only
QUEST_FROZEN_READ_ONLY_ACK_COMMAND=/usr/local/sbin/quest-release-quest-frozen-read-only-ack
VALORANT_FROZEN_READ_ONLY_ACK_COMMAND=/usr/local/sbin/quest-release-valorant-frozen-read-only-ack
# The admission boundary is deliberately two acknowledgements, in this order.
POST_COMMIT_RECOVERY_ARM_COMMAND=/usr/local/sbin/quest-release-post-commit-recovery-arm
QUEST_WRITER_ENABLE_COMMAND=/usr/local/sbin/quest-release-quest-writer-enable
VALORANT_WRITER_ENABLE_COMMAND=/usr/local/sbin/quest-release-valorant-writer-enable
# WRITER_STOP_COMMAND is retained for rollback.sh's post-commit operator path.
# release.sh and cutover.sh require and invoke both group-specific stop hooks.
QUEST_WRITER_STOP_COMMAND=/usr/local/sbin/quest-release-quest-writer-stop
VALORANT_WRITER_STOP_COMMAND=/usr/local/sbin/quest-release-valorant-writer-stop
WRITER_STOP_COMMAND=/usr/local/sbin/quest-release-writers-stop
CURRENT_STATE_CAPTURE_COMMAND=/usr/local/sbin/quest-release-current-state-capture
RECOVERY_ACTION_COMMAND=/usr/local/sbin/quest-release-recovery-action
# Post-first-write recovery requires an explicit fix-forward or controlled-
# restore decision, expected loss/RPO, and incident-owner approval. This command
# is intentionally rejected if configured; Supabase URL rollback is never blind.
SUPABASE_RECONCILIATION_DECISION=
EXPECTED_LOSS_RPO=
INCIDENT_OWNER_APPROVAL=
SUPABASE_URL_ROLLBACK_COMMAND=
RELEASE_MIN_FREE_KB=1048576
