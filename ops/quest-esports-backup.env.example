# Install the real file as root:deploy with mode 640 so only root and the backup service can read it.
# The backup launches the exact approved PostgreSQL 17 image as a read-only,
# short-lived client on quest-shared; PostgreSQL remains unpublished on the host.
PATH=/usr/lib/postgresql/17/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
DOCKER_BIN=/usr/bin/docker
# This is a trust bundle, not client identity material. It must contain the
# issuer of /etc/quest-esports/tls/quest-postgres.crt (and any intermediates
# needed to build that chain). Keep this deploy-readable copy/bundle under the
# separate client hierarchy so User=deploy can complete verify-full connections.
POSTGRES_CA_FILE=/etc/quest-esports-backup/backup-client-ca.crt
# Separate backup client identity; never reuse the PostgreSQL server key. The
# client directory is deliberately outside /etc/quest-esports: that parent is
# root:root 0750 for container/server TLS and is not traversable by deploy.
# Install this directory as root:deploy 0750 and all three client TLS files as
# root:deploy 0640; no group/other write or broader secret directory access is
# permitted.
BACKUP_CLIENT_TLS_DIR=/etc/quest-esports-backup
BACKUP_CLIENT_CERT_FILE=/etc/quest-esports-backup/backup-client.crt
BACKUP_CLIENT_KEY_FILE=/etc/quest-esports-backup/backup-client.key
# Inject the protected quest_backup URL out of band; no credential-bearing URL
# is represented in this template.
DIRECT_URL=
POSTGRES_TARGET_HOST=quest-postgres
POSTGRES_TARGET_PORT=5432
POSTGRES_TARGET_DATABASE=quest
POSTGRES_TARGET_MAJOR=17
POSTGRES_TARGET_DATA_ROOT=/srv/quest-esports/postgres/17/data
POSTGRES_TARGET_SENTINEL_COMMAND=/usr/local/sbin/quest-release-postgres-target
UPLOAD_ROOT=/srv/quest-esports/uploads
PRIVATE_UPLOAD_ROOT=/srv/quest-esports/private
BACKUP_ROOT=/srv/quest-esports/backups
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_OFFLINE_RECOVERY_PUBLIC_KEY
# The age private identity is never configured on the production backup host;
# it is supplied only by the isolated restore environment.
# Each configured remote has its own rclone config and credential/token. Keep
# entries newline-separated; labels are local names and are never sent to rclone.
BACKUP_RCLONE_REMOTES='primary=quest-backups-custom:quest-esports-v2/production
secondary=quest-backups-secondary:quest-esports-v2/production'
BACKUP_RCLONE_CONFIGS='primary=/srv/quest-esports/rclone/quest-primary.conf
secondary=/srv/quest-esports/rclone/quest-secondary.conf'
# Transition-only single-remote form (used when BACKUP_RCLONE_REMOTES is unset):
# BACKUP_RCLONE_REMOTE=quest-backups-custom:quest-esports-v2/production
# RCLONE_CONFIG=/srv/quest-esports/rclone/quest-esports.conf
BACKUP_LOCAL_RETENTION_DAYS=7
# The unit runs as root so the containerized PostgreSQL client can reach the
# Docker socket; artifacts are handed back to this group as root:deploy 0640 so
# the unprivileged freshness check can still read them.
BACKUP_ARTIFACT_GROUP=deploy
# Alert if no locally valid and remotely matching archive/checksum pair is newer than 36 hours.
BACKUP_MAX_AGE_MINUTES=2160
# Off-site deletion is performed only by the separately guarded prune script.
BACKUP_REMOTE_RETENTION_DAYS=90
BACKUP_REMOTE_MINIMUM_RECOVERY_POINTS=14
# Optional Discord-compatible HTTPS webhook used by the systemd OnFailure unit.
BACKUP_FAILURE_WEBHOOK_URL=
