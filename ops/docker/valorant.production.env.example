# VALORANT runtime-only database environment. Install the completed file as
# /etc/quest-esports/valorant.production.env with root ownership and mode 0600
# or 0640. Do not place migrator or recovery-administrator URLs here.
DATABASE_URL=
DIRECT_URL=

# Required runtime URL shape after secret injection:
# postgresql://<val-runtime-user>:<secret-managed-runtime-password>@quest-postgres:5432/quest?schema=valorant&sslmode=verify-full&sslrootcert=/run/secrets/quest-private-ca.crt
# Both URLs must use val_runtime and the canonical private CA. Migration URLs
# are injected only into one-shot commands through protected out-of-band files.
