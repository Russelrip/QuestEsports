# VALORANT runtime-only database environment. Install the completed file as
# /etc/quest-esports/valorant.production.env with root ownership and mode 0600
# or 0640. Do not place migrator or recovery-administrator URLs here.
APP_ENV=production
DATABASE_URL=
DIRECT_URL=

# Required VALORANT upstream and Quest service-boundary credentials. Inject
# secret values out of band; this template intentionally contains no secrets.
HENRIK_API_KEY=
HENRIK_BASE_URL=https://api.henrikdev.xyz
HENRIK_AUTH_SCHEME=bare
QUEST_SERVICE_SHARED_SECRETS=
QUEST_SERVICE_ISSUER=quest-esports
QUEST_SERVICE_AUDIENCE=valorant-platform
SERVICE_TOKEN_MAX_SKEW_SECONDS=30

# Discord OAuth and the two Discord worker identities. The redirect must be the
# exact HTTPS URL registered in the Discord application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://questesports.lk/register
DISCORD_TOKEN_1=
DISCORD_TOKEN_2=
DISCORD_GUILD_ID=<discord-guild-id>
ADMIN_API_KEY=

# The application starts with writers admitted. Release freeze hooks replace
# this value with validation before candidate checks.
WRITE_FREEZE_MODE=off

# Required runtime URL shape after secret injection:
# postgresql+asyncpg://<val-runtime-user>:<secret-managed-runtime-password>@quest-postgres:5432/quest?ssl=require
# Both URLs must use val_runtime. `ssl=require` is the only asyncpg URL TLS
# option here; libpq-only `sslmode` and `sslrootcert` parameters are forbidden.
# The repository validates these input values and the mounted CA, but cannot
# inspect the external image's Python code or prove that it consumes them. The
# VALORANT image owner must attest that it builds an SSL context with hostname
# verification and a required CA, then passes that context as asyncpg's `ssl` connect
# argument. Migration URLs are injected only into one-shot commands
# through protected out-of-band files.
# The external image's Python TLS implementation must produce an equivalent
# context: `check_hostname=True` and `verify_mode=ssl.CERT_REQUIRED`.
# The external image must pass the configured context as asyncpg's `ssl` connect argument.
VALORANT_DATABASE_SSL_CA_FILE=/run/secrets/quest-private-ca.crt
VALORANT_DATABASE_SSL_SERVER_HOSTNAME=quest-postgres
VALORANT_DATABASE_SSL_VERIFY=full
