# Production runtime configuration template.
#
# Copy the completed, secret-managed file to
# /etc/quest-esports/quest.production.env. Do not commit that copy. Image
# references belong only to the release bundle's private Compose .env; they are
# intentionally not injected into the backend runtime environment. The approved
# PostgreSQL image is postgres:17-bookworm@sha256:051f7b7b3abdd564d5d1bd1e8c4b9c1b6e77087d1dd22020ede611c096a272e0.

NODE_ENV=production
PORT=5001
APP_URL=https://questesports.lk
API_PUBLIC_URL=https://api.questesports.lk
CORS_ORIGIN=https://questesports.lk

# Supply values through the secret manager. Both URLs are deliberately runtime
# role URLs: the backend container must never receive a migrator or recovery
# administrator credential. Both URLs use the private CA, full certificate
# verification, and the stable database alias. The temporary staging overlay
# uses its own host-loopback port and never changes these URLs.
DATABASE_URL=
DIRECT_URL=
# Required URL shape after secret injection:
# postgresql://<quest-runtime-user>:<secret-managed-runtime-password>@quest-postgres:5432/quest?schema=public&sslmode=verify-full&sslrootcert=/run/secrets/quest-private-ca.crt
# DIRECT_URL must use the same quest_runtime role. The migrator URL is supplied
# only to the one-shot migration/security wrapper through its protected
# out-of-band URL-file setting; it is not part of this env file.

# Required application credential names. Values are injected by secret
# management; no credential value belongs in this file.
AUTH_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=quest_session
TRUST_PROXY=1
REQUIRE_API_ORIGIN=true
JOB_WORKER_ENABLED=true
MOBILE_ADMIN_OAUTH_REDIRECT_URL=https://api.questesports.lk/mobile-admin-oauth
MOBILE_ADMIN_ANDROID_CERT_SHA256=<64-hex-byte-colon-separated-android-signing-fingerprint>
VALORANT_SERVICE_KEY_ID=
VALORANT_SERVICE_SECRET=
VALORANT_INTERNAL_BASE_URL=https://valorant-platform:8000

# Password delivery is required in production. Choose one complete provider
# configuration; this template documents the SMTP variant.
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@questesports.lk
MAIL_DELIVERY_REQUIRED=true

# The PostgreSQL administrator password is deliberately NOT in this shared
# file. Compose injects it only into PostgreSQL via POSTGRES_PASSWORD_FILE from
# /etc/quest-esports/secrets/postgres-admin-password.

# The Quest container trusts the private CA used by the sibling VALORANT API.
NODE_EXTRA_CA_CERTS=/run/secrets/quest-private-ca.crt

# These are the durable host roots mounted by Compose and must not be changed
# to a container layer or a source checkout.
UPLOAD_ROOT=/srv/quest-esports/uploads
PRIVATE_UPLOAD_ROOT=/srv/quest-esports/private
POSTGRES_DATA_ROOT=/srv/quest-esports/postgres/17/data
# Temporary staging overlay only; this is not a PostgreSQL production
# publication and must remain bound to 127.0.0.1.
POSTGRES_STAGING_HOST_PORT=55432

# Fixed deployment identities. quest-shared is created by host bootstrap before
# either Compose project is started.
COMPOSE_PROJECT_NAME=quest-prod
QUEST_SHARED_NETWORK=quest-shared

# TLS material is provisioned separately with restrictive ownership/mode.
POSTGRES_CA_FILE=/etc/quest-esports/tls/quest-private-ca.crt
POSTGRES_CA_RUNTIME_FILE=/run/postgresql/tls/ca.crt
