# Production runtime configuration template.
#
# Copy the completed, secret-managed file to
# /etc/quest-esports/quest.production.env. Do not commit that copy. The release
# manifest supplies the four image references below; each must be an immutable
# registry digest, never a mutable tag.

QUEST_FRONTEND_IMAGE=
QUEST_BACKEND_IMAGE=
QUEST_MIGRATOR_IMAGE=
POSTGRES_IMAGE=
# POSTGRES_IMAGE must resolve to postgres:17-bookworm@sha256:<64-hex-digest>.

NODE_ENV=production
PORT=5001
APP_URL=https://questesports.lk
API_PUBLIC_URL=https://api.questesports.lk
CORS_ORIGIN=https://questesports.lk

# Supply values through the secret manager. Both URLs must use the private CA,
# full certificate verification, and the stable database alias.
DATABASE_URL=postgresql://QUEST_RUNTIME_USER:QUEST_RUNTIME_PASSWORD@quest-postgres:5432/quest?schema=public&sslmode=verify-full&sslrootcert=/run/secrets/quest-private-ca.crt
DIRECT_URL=postgresql://QUEST_MIGRATOR_USER:QUEST_MIGRATOR_PASSWORD@quest-postgres:5432/quest?schema=public&sslmode=verify-full&sslrootcert=/run/secrets/quest-private-ca.crt
POSTGRES_PASSWORD=

# Required application credential names. Values are intentionally absent.
AUTH_ENCRYPTION_KEY=
SESSION_SECRET=
SESSION_COOKIE_NAME=quest_session
MOBILE_ADMIN_OAUTH_REDIRECT_URL=https://api.questesports.lk/mobile-admin-oauth
VALORANT_SERVICE_KEY_ID=
VALORANT_SERVICE_SECRET=
VALORANT_INTERNAL_BASE_URL=https://valorant-platform:8000

# The Quest container trusts the private CA used by the sibling VALORANT API.
NODE_EXTRA_CA_CERTS=/run/secrets/quest-private-ca.crt

# These are the durable host roots mounted by Compose and must not be changed
# to a container layer or a source checkout.
UPLOAD_ROOT=/srv/quest-esports/uploads
PRIVATE_UPLOAD_ROOT=/srv/quest-esports/private
POSTGRES_DATA_ROOT=/srv/quest-esports/postgres/17/data

# Fixed deployment identities. quest-shared is created by host bootstrap before
# either Compose project is started.
COMPOSE_PROJECT_NAME=quest-prod
QUEST_SHARED_NETWORK=quest-shared

# TLS material is provisioned separately with restrictive ownership/mode.
POSTGRES_CA_FILE=/etc/quest-esports/tls/quest-private-ca.crt
POSTGRES_CERT_FILE=/etc/quest-esports/tls/quest-postgres.crt
POSTGRES_KEY_FILE=/etc/quest-esports/tls/quest-postgres.key
POSTGRES_CA_RUNTIME_FILE=/run/postgresql/tls/ca.crt
POSTGRES_CERT_RUNTIME_FILE=/run/postgresql/tls/server.crt
POSTGRES_KEY_RUNTIME_FILE=/run/postgresql/tls/server.key
