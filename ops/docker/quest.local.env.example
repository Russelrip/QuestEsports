# Local container environment for Quest Express.
#
# Copy to ops/docker/quest.local.env and fill in only what you need. This file
# is DELIBERATELY separate from backend/.env: that file points at a remote
# Supabase project, and a containerised backend must never reach it by accident.
#
# DATABASE_URL and DIRECT_URL are set by compose and always override anything
# here, so the local Postgres container wins even if this file is misconfigured.

NODE_ENV=development
PORT=5001
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5001
CORS_ORIGIN=http://localhost:3000

SESSION_SECRET=local-development-session-secret-change-me
SESSION_COOKIE_NAME=quest_session

# Reached over the compose network by service name, never localhost:8000.
VALORANT_INTERNAL_BASE_URL=http://valorant-backend:8000
VALORANT_SERVICE_KEY_ID=local
VALORANT_SERVICE_SECRET=local-development-shared-secret-change-me

# Optional. Leave blank unless you are working on these flows.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:5001/api/auth/discord/callback
