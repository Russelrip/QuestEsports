  assignedStaff       User?                     @relation("SupportConversationAssignee", fields: [assignedStaffUserId], references: [id], onDelete: SetNull)
  messages            SupportMessage[]
  reads               SupportConversationRead[]

  @@index([ownerUserId, status, updatedAt])
  @@index([assignedStaffUserId, status, updatedAt])
  @@map("support_conversations")
}

model SupportMessage {
  id             String              @id @default(uuid()) @db.Uuid
