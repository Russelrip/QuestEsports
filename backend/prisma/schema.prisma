// The canonical title. Before this model, "which game" was stated seven
// different ways — a free-text column on Tournament, Rulebook,
// RecruitmentApplication, SavedTeam and three veto catalog models, plus the
// GameCategory row that drives the public game pages. Nothing tied them
// together, so a tournament could reference a rulebook for a different title
// and no constraint objected.
//
// `slug` is the join key and deliberately carries the same values as the
// GameAccountGame enum, so the enum and this table agree by construction rather
// than by convention. Adding a title stays additive: one row here, one enum
// value, one adapter.
//
// This model is identity only. GameCategory keeps presentation — artwork, logo,
// ordering, publication — and now points at the title it presents.
model Game {
  id                      String                   @id @default(uuid()) @db.Uuid
  slug                    String                   @unique
  displayName             String                   @map("display_name")
  shortName               String?                  @map("short_name")
  isActive                Boolean                  @default(true) @map("is_active")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  categories              GameCategory[]
  tournaments             Tournament[]
  rulebooks               Rulebook[]
  savedTeams              SavedTeam[]
  recruitmentApplications RecruitmentApplication[]
  vetoMaps                VetoMap[]
  vetoMapPools            VetoMapPool[]
  vetoRulePresets         VetoRulePreset[]
  aliases                 GameAlias[]

  @@index([isActive])
  @@map("games")
}

// Every alternative spelling that must resolve to one title. A machine cannot
// know that "COD Mobile" and "codm" name the same product — normalising text
// alone would create a second title for one that already exists. Aliases are
// stored already-normalised, so resolution is a plain equality match.
model GameAlias {
  id        String   @id @default(uuid()) @db.Uuid
  alias     String   @unique
  gameId    String   @map("game_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("game_aliases")
}

model GameCategory {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique
  displayName  String       @map("display_name")
  artworkName  String?      @map("artwork_name")
  logoName     String?      @map("logo_name")
  displayOrder Int          @default(100) @map("display_order")
  isPublished  Boolean      @default(false) @map("is_published")
  gameId       String?      @map("game_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  game         Game?        @relation(fields: [gameId], references: [id], onDelete: SetNull)
  tournaments  Tournament[]

  @@index([isPublished, displayOrder])
  @@index([gameId])
  @@map("game_categories")
}

