model Tournament {
  id                         String                      @id @default(uuid()) @db.Uuid
  slug                       String                      @unique
  title                      String
  game                       String
  gameId                     String?                     @map("game_id") @db.Uuid
  gameCategoryId             String?                     @map("game_category_id") @db.Uuid
  organizer                  String                      @default("Quest E-sports")
  country                    String                      @default("Sri Lanka")
  location                   String                      @default("TBA")
  seriesId                   String?                     @map("series_id") @db.Uuid
  seriesOrder                Int                         @default(100) @map("series_order")
  displayPriority            Int                         @default(100) @map("display_priority")
  bannerImageName            String?                     @map("banner_image_name")
  heroImageName              String?                     @map("hero_image_name")
  scheduleFileName           String?                     @map("schedule_file_name")
  scheduleData               Json?                       @map("schedule_data")
  completedPosterImageName   String?                     @map("completed_poster_image_name")
  firstPlaceImageName        String?                     @map("first_place_image_name")
  secondPlaceImageName       String?                     @map("second_place_image_name")
  thirdPlaceImageName        String?                     @map("third_place_image_name")
  shortDescription           String                      @map("short_description")
  fullDescription            String                      @map("full_description")
  rules                      String?
  rulebookId                 String?                     @map("rulebook_id") @db.Uuid
  registrationOpenAt         DateTime?                   @map("registration_open_at")
  startDate                  DateTime?                   @map("start_date")
  startDateStatus            TournamentDateStatus        @default(scheduled) @map("start_date_status")
  endDate                    DateTime?                   @map("end_date")
  endDateStatus              TournamentDateStatus        @default(scheduled) @map("end_date_status")
  registrationDeadline       DateTime?                   @map("registration_deadline")
  registrationDeadlineStatus TournamentDateStatus        @default(scheduled) @map("registration_deadline_status")
  format                     String
  registrationMode           TournamentRegistrationMode  @default(open_entry) @map("registration_mode")
  entryType                  TournamentEntryType         @default(team) @map("entry_type")
  teamSize                   Int                         @map("team_size")
  minRosterSize              Int                         @default(1) @map("min_roster_size")
  maxRosterSize              Int                         @default(5) @map("max_roster_size")
  maxSubstitutes             Int                         @default(0) @map("max_substitutes")
  allowCoach                 Boolean                     @default(false) @map("allow_coach")
  coachRequired              Boolean                     @default(false) @map("coach_required")
  // Whether every roster member must have a connected Discord identity before
  // the team can register. Defaults off so existing tournaments are unaffected.
  discordRequired            Boolean                     @default(false) @map("discord_required")
  registrationFields         Json                        @default("[]") @map("registration_fields")
  paymentMethod              TournamentPaymentMethod     @default(free) @map("payment_method")
  registrationFeeAmount      Decimal                     @default(0) @map("registration_fee_amount") @db.Decimal(12, 2)
  registrationFeeCurrency    String                      @default("LKR") @map("registration_fee_currency")
  registrationFeeTiers       Json                        @default("[]") @map("registration_fee_tiers")
  reservationMinutes         Int                         @default(1440) @map("reservation_minutes")
  bankTransferReviewMinutes  Int                         @default(1440) @map("bank_transfer_review_minutes")
  waitlistEnabled            Boolean                     @default(false) @map("waitlist_enabled")
  bankName                   String?                     @map("bank_name")
  bankBranch                 String?                     @map("bank_branch")
  bankAccountName            String?                     @map("bank_account_name")
  bankAccountNumber          String?                     @map("bank_account_number")
  maxTeams                   Int                         @map("max_teams")
  prizePool                  String                      @map("prize_pool")
  status                     TournamentStatus            @default(draft)
  isPublished                Boolean                     @default(false) @map("is_published")
