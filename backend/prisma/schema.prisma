generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  user
  admin
}

enum AuthProvider {
  google
  discord
}

enum RegistrationMemberRole {
  CAPTAIN
  PLAYER
  SUBSTITUTE
  COACH
}

enum TournamentStatus {
  draft
  upcoming
  registration_open
  ongoing
  completed
  cancelled
}

enum TournamentDateStatus {
  scheduled
  tba
  tbd
}

enum TournamentRegistrationMode {
  open_entry
  slot_based
}

enum TournamentEntryType {
  team
  solo
}

enum TournamentPaymentMethod {
  free
  payhere
  bank_transfer
}

enum TeamRegistrationStatus {
  pending
  approved
  rejected
}

enum RegistrationPaymentStatus {
  unpaid
  pending
  paid
}

enum PaymentPurpose {
  tournament_registration
  merchandise_order
  ticket_order
}

enum PaymentTransactionStatus {
  created
  pending
  paid
  cancelled
  failed
  charged_back
  expired
  review_required
  refunded
}

enum ProductStatus {
  draft
  active
  archived
}

enum MerchandiseOrderStatus {
  pending_payment
  paid
  processing
  fulfilled
  cancelled
  refunded
}

enum TicketEventStatus {
  draft
  on_sale
  sales_paused
  sales_closed
  completed
  cancelled
}

enum TicketOrderStatus {
  pending_payment
  paid
  cancelled
  expired
  refunded
}

enum TicketStatus {
  pending
  valid
  checked_in
  cancelled
  refunded
}

enum TicketScanResult {
  accepted
  already_used
  invalid_code
  invalid_status
  wrong_event
}

enum RegistrationVerificationStatus {
  pending
  verified
  flagged
}

enum TeamMemberInviteStatus {
  pending
  accepted
  declined
}

enum BackgroundJobStatus {
  queued
  processing
  succeeded
  failed
}

enum RecruitmentApplicationStatus {
  pending
  reviewed
  accepted
  rejected
}

enum TournamentStaffRole {
  tournament_admin
  referee
}

enum MatchSource {
  quest
  challonge
}

enum MatchStatus {
  not_scheduled
  scheduled
  check_in_open
  veto_starting_soon
  veto_in_progress
  ready
  live
  delayed
  paused
  completed
  cancelled
  walkover
}

enum ChallongeSyncFrequency {
  manual
  one_minute
  five_minutes
}

enum ChallongeSyncStatus {
  running
  succeeded
  failed
  skipped
}

model DeploymentEnvironment {
  id          Int      @id @default(1)
  environment String   @unique
  projectRef  String?  @map("project_ref")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("deployment_environment")
}

model User {
  id                      String                      @id @default(uuid()) @db.Uuid
  firstName               String                      @map("first_name")
  lastName                String                      @map("last_name")
  email                   String
  emailNormalized         String                      @unique @map("email_normalized")
  pendingEmail            String?                     @map("pending_email")
  pendingEmailNormalized  String?                     @unique @map("pending_email_normalized")
  username                String
  usernameNormalized      String                      @unique @map("username_normalized")
  passwordHash            String                      @map("password_hash")
  emailVerified           Boolean                     @default(false) @map("email_verified")
  emailVerifiedAt         DateTime?                   @map("email_verified_at")
  role                    UserRole                    @default(user)
  phone                   String?
  discordTag              String?                     @map("discord_tag")
  avatarImageName         String?                     @map("avatar_image_name")
  lastLoginAt             DateTime?                   @map("last_login_at")
  failedLoginCount        Int                         @default(0) @map("failed_login_count")
  lastFailedLoginAt       DateTime?                   @map("last_failed_login_at")
  lockedUntil             DateTime?                   @map("locked_until")
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  sessions                Session[]
  verificationTokens      VerificationToken[]
  emailChangeTokens       EmailChangeToken[]
  passwordResetTokens     PasswordResetToken[]
  mobileOAuthGrants       MobileOAuthGrant[]
  oauthAccounts           OAuthAccount[]
  savedTeams              SavedTeam[]
  savedTeamMemberships    SavedTeamMember[]
  registrationMemberships RegistrationMember[]
  recruitmentApplications RecruitmentApplication[]
  tournamentRegistrations TeamRegistration[]
  merchandiseOrders       MerchandiseOrder[]
  ticketOrders            TicketOrder[]
  checkedInTickets        Ticket[]                    @relation("TicketCheckInStaff")
  ticketScans             TicketScan[]                @relation("TicketScanStaff")
  reviewedPaymentProofs   BankTransferProof[]         @relation("PaymentProofReviewer")
  reconciledPayments      PaymentTransaction[]        @relation("PaymentReconciler")
  adminSlotReservations   AdminSlotReservation[]
  tournamentStaff         TournamentStaffAssignment[]
  assignedMatches         Match[]                     @relation("AssignedMatchStaff")
  auditLogs               AuditLog[]                  @relation("AuditActor")

  @@index([role])
  @@index([createdAt])
  @@index([lockedUntil])
  @@map("users")
}

model EventSeries {
  id            String       @id @default(uuid()) @db.Uuid
  slug          String       @unique
  title         String
  description   String
  heroImageName String?      @map("hero_image_name")
  displayOrder  Int          @default(100) @map("display_order")
  isPublished   Boolean      @default(false) @map("is_published")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  tournaments   Tournament[]
  ticketEvent   TicketEvent?

  @@index([isPublished, displayOrder])
  @@map("event_series")
}

model GameCategory {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique
  displayName  String       @map("display_name")
  artworkName  String?      @map("artwork_name")
  logoName     String?      @map("logo_name")
  displayOrder Int          @default(100) @map("display_order")
  isPublished  Boolean      @default(false) @map("is_published")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  tournaments  Tournament[]

  @@index([isPublished, displayOrder])
  @@map("game_categories")
}

model RecruitmentApplication {
  id                          String                       @id @default(uuid()) @db.Uuid
  userId                      String                       @map("user_id") @db.Uuid
  applicationType             String                       @map("application_type")
  fullName                    String                       @map("full_name")
  email                       String
  phone                       String
  discord                     String
  game                        String
  playerId                    String?                      @map("player_id")
  applicantIdNumberCiphertext String?                      @map("applicant_id_number_ciphertext")
  teamName                    String?                      @map("team_name")
  currentRosterSize           Int?                         @map("current_roster_size")
  members                     Json
  details                     Json                         @default("{}")
  notes                       String?
  womensLeagueInterest        Boolean                      @default(false) @map("womens_league_interest")
  privacyPolicyVersion        String?                      @map("privacy_policy_version")
  privacyAcceptedAt           DateTime?                    @map("privacy_accepted_at")
  status                      RecruitmentApplicationStatus @default(pending)
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("recruitment_applications")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailChangeToken {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  nextEmail           String    @map("next_email")
  nextEmailNormalized String    @map("next_email_normalized")
  tokenHash           String    @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at")
  usedAt              DateTime? @map("used_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextEmailNormalized])
  @@index([expiresAt])
  @@map("email_change_tokens")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime? @map("last_seen_at")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  rememberMe Boolean   @default(false) @map("remember_me")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model MobileOAuthGrant {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  provider  AuthProvider
  tokenHash String       @unique @map("token_hash")
  codeChallenge String?  @map("code_challenge")
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("mobile_oauth_grants")
}

model OAuthAccount {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  email          String?      @map("email")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model ContactSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([isRead, createdAt])
  @@map("contact_submissions")
}

model Tournament {
  id                         String                      @id @default(uuid()) @db.Uuid
  slug                       String                      @unique
  title                      String
  game                       String
  gameCategoryId             String?                     @map("game_category_id") @db.Uuid
  organizer                  String                      @default("Quest E-sports")
  country                    String                      @default("Sri Lanka")
  location                   String                      @default("TBA")
  seriesId                   String?                     @map("series_id") @db.Uuid
  seriesOrder                Int                         @default(100) @map("series_order")
  displayPriority            Int                         @default(100) @map("display_priority")
  bannerImageName            String?                     @map("banner_image_name")
  heroImageName              String?                     @map("hero_image_name")
  scheduleFileName           String?                     @map("schedule_file_name")
  scheduleData               Json?                       @map("schedule_data")
  completedPosterImageName   String?                     @map("completed_poster_image_name")
  firstPlaceImageName        String?                     @map("first_place_image_name")
  secondPlaceImageName       String?                     @map("second_place_image_name")
  thirdPlaceImageName        String?                     @map("third_place_image_name")
  shortDescription           String                      @map("short_description")
  fullDescription            String                      @map("full_description")
  rules                      String?
  rulebookId                 String?                     @map("rulebook_id") @db.Uuid
  registrationOpenAt         DateTime?                   @map("registration_open_at")
  startDate                  DateTime?                   @map("start_date")
  startDateStatus            TournamentDateStatus        @default(scheduled) @map("start_date_status")
  endDate                    DateTime?                   @map("end_date")
  endDateStatus              TournamentDateStatus        @default(scheduled) @map("end_date_status")
  registrationDeadline       DateTime?                   @map("registration_deadline")
  registrationDeadlineStatus TournamentDateStatus        @default(scheduled) @map("registration_deadline_status")
  format                     String
  registrationMode           TournamentRegistrationMode  @default(open_entry) @map("registration_mode")
  entryType                  TournamentEntryType         @default(team) @map("entry_type")
  teamSize                   Int                         @map("team_size")
  minRosterSize              Int                         @default(1) @map("min_roster_size")
  maxRosterSize              Int                         @default(5) @map("max_roster_size")
  maxSubstitutes             Int                         @default(0) @map("max_substitutes")
  registrationFields         Json                        @default("[]") @map("registration_fields")
  paymentMethod              TournamentPaymentMethod     @default(free) @map("payment_method")
  registrationFeeAmount      Decimal                     @default(0) @map("registration_fee_amount") @db.Decimal(12, 2)
  registrationFeeCurrency    String                      @default("LKR") @map("registration_fee_currency")
  registrationFeeTiers       Json                        @default("[]") @map("registration_fee_tiers")
  reservationMinutes         Int                         @default(1440) @map("reservation_minutes")
  bankTransferReviewMinutes  Int                         @default(1440) @map("bank_transfer_review_minutes")
  bankName                   String?                     @map("bank_name")
  bankBranch                 String?                     @map("bank_branch")
  bankAccountName            String?                     @map("bank_account_name")
  bankAccountNumber          String?                     @map("bank_account_number")
  maxTeams                   Int                         @map("max_teams")
  prizePool                  String                      @map("prize_pool")
  status                     TournamentStatus            @default(draft)
  isPublished                Boolean                     @default(false) @map("is_published")
  bracketLink                String?                     @map("bracket_link")
  contactLink                String?                     @map("contact_link")
  isFeatured                 Boolean                     @default(false) @map("is_featured")
  isActive                   Boolean                     @default(true) @map("is_active")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  teamRegistrations          TeamRegistration[]
  posters                    Poster[]
  bracket                    TournamentBracket?
  rulebook                   Rulebook?                   @relation(fields: [rulebookId], references: [id], onDelete: SetNull)
  series                     EventSeries?                @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  gameCategory               GameCategory?               @relation(fields: [gameCategoryId], references: [id], onDelete: SetNull)
  sponsors                   TournamentSponsor[]
  adminSlotReservations      AdminSlotReservation[]
  staffAssignments           TournamentStaffAssignment[]
  matches                    Match[]
  challongeIntegration       ChallongeIntegration?

  @@index([isActive])
  @@index([isPublished, status, startDate])
  @@index([isFeatured, isPublished])
  @@index([displayPriority, startDate])
  @@index([rulebookId])
  @@index([seriesId, seriesOrder])
  @@index([gameCategoryId])
  @@map("tournaments")
}

model TournamentSponsor {
  id               String     @id @default(uuid()) @db.Uuid
  tournamentId     String     @map("tournament_id") @db.Uuid
  name             String
  partnershipLabel String     @default("Official Sponsor") @map("partnership_label")
  logoImageName    String?    @map("logo_image_name")
  websiteUrl       String?    @map("website_url")
  displayOrder     Int        @default(100) @map("display_order")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, displayOrder])
  @@map("tournament_sponsors")
}

model Rulebook {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique
  title       String
  game        String
  variant     String       @default("Standard")
  content     String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  tournaments Tournament[]

  @@index([game])
  @@index([game, variant])
  @@index([createdAt])
  @@map("rulebooks")
}

model TournamentBracket {
  id            String     @id @default(uuid()) @db.Uuid
  tournamentId  String     @unique @map("tournament_id") @db.Uuid
  format        String     @default("double_elimination")
  status        String     @default("draft")
  seedData      Json       @map("seed_data")
  bracketData   Json       @map("bracket_data")
  generatedAt   DateTime   @default(now()) @map("generated_at")
  publishedAt   DateTime?  @map("published_at")
  lastUpdatedAt DateTime   @updatedAt @map("last_updated_at")
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("tournament_brackets")
}

model TournamentStaffAssignment {
  id           String              @id @default(uuid()) @db.Uuid
  tournamentId String              @map("tournament_id") @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  role         TournamentStaffRole
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  tournament   Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId, role])
  @@index([userId, role])
  @@index([tournamentId, role])
  @@map("tournament_staff_assignments")
}

model Match {
  id                String             @id @default(uuid()) @db.Uuid
  tournamentId      String             @map("tournament_id") @db.Uuid
  source            MatchSource        @default(quest)
  externalId        String?            @map("external_id")
  identifier        String?
  roundNumber       Int?               @map("round_number")
  status            MatchStatus        @default(not_scheduled)
  scheduledAt       DateTime?          @map("scheduled_at")
  estimatedAt       DateTime?          @map("estimated_at")
  station           String?
  checkInDeadline   DateTime?          @map("check_in_deadline")
  vetoStartAt       DateTime?          @map("veto_start_at")
  assignedStaffId   String?            @map("assigned_staff_id") @db.Uuid
  localNotes        String?            @map("local_notes")
  scoreData         Json               @default("{}") @map("score_data")
  winnerSlot        Int?               @map("winner_slot")
  completedAt       DateTime?          @map("completed_at")
  externalUpdatedAt DateTime?          @map("external_updated_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  tournament        Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  assignedStaff     User?              @relation("AssignedMatchStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  participants      MatchParticipant[]

  @@unique([tournamentId, source, externalId])
  @@index([tournamentId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([assignedStaffId, scheduledAt])
  @@index([source, externalUpdatedAt])
  @@map("matches")
}

model MatchParticipant {
  id                    String            @id @default(uuid()) @db.Uuid
  matchId               String            @map("match_id") @db.Uuid
  slot                  Int
  registrationId        String?           @map("registration_id") @db.Uuid
  externalParticipantId String?           @map("external_participant_id")
  displayName           String            @map("display_name")
  seed                  Int?
  score                 String?
  result                String?
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  match                 Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  registration          TeamRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@unique([matchId, slot])
  @@index([registrationId])
  @@index([externalParticipantId])
  @@map("match_participants")
}

model ChallongeIntegration {
  id                   String                     @id @default(uuid()) @db.Uuid
  tournamentId         String                     @unique @map("tournament_id") @db.Uuid
  identifier           String
  enabled              Boolean                    @default(false)
  automaticSyncEnabled Boolean                    @default(false) @map("automatic_sync_enabled")
  syncFrequency        ChallongeSyncFrequency     @default(five_minutes) @map("sync_frequency")
  snapshotData         Json?                      @map("snapshot_data")
  snapshotHash         String?                    @map("snapshot_hash")
  snapshotUpdatedAt    DateTime?                  @map("snapshot_updated_at")
  nextSyncAt           DateTime?                  @map("next_sync_at")
  syncLeaseUntil       DateTime?                  @map("sync_lease_until")
  lastAttemptAt        DateTime?                  @map("last_attempt_at")
  lastSuccessAt        DateTime?                  @map("last_success_at")
  lastErrorCode        String?                    @map("last_error_code")
  lastErrorMessage     String?                    @map("last_error_message")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")
  tournament           Tournament                 @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participantLinks     ChallongeParticipantLink[]
  syncLogs             ChallongeSyncLog[]

  @@index([enabled, nextSyncAt])
  @@index([syncLeaseUntil])
  @@map("challonge_integrations")
}

model ChallongeParticipantLink {
  id                    String               @id @default(uuid()) @db.Uuid
  integrationId         String               @map("integration_id") @db.Uuid
  externalParticipantId String               @map("external_participant_id")
  registrationId        String?              @map("registration_id") @db.Uuid
  displayName           String               @map("display_name")
  seed                  Int?
  isConfirmed           Boolean              @default(false) @map("is_confirmed")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  integration           ChallongeIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  registration          TeamRegistration?    @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  // PostgreSQL truncates Prisma's generated name for this composite key differently
  // from Prisma's own identifier shortening. Keep the mapped name explicit so a
  // freshly migrated database and the datamodel remain identical.
  @@unique([integrationId, externalParticipantId], map: "challonge_participant_links_integration_id_external_participant")
  @@index([registrationId, isConfirmed])
  @@map("challonge_participant_links")
}

model ChallongeSyncLog {
  id               String               @id @default(uuid()) @db.Uuid
  integrationId    String               @map("integration_id") @db.Uuid
  identifier       String?
  status           ChallongeSyncStatus
  trigger          String
  requestId        String?              @map("request_id")
  httpStatus       Int?                 @map("http_status")
  errorCode        String?              @map("error_code")
  errorMessage     String?              @map("error_message")
  tournamentState  String?              @map("tournament_state")
  participantCount Int                  @default(0) @map("participant_count")
  matchCount       Int                  @default(0) @map("match_count")
  durationMs       Int?                 @map("duration_ms")
  startedAt        DateTime             @default(now()) @map("started_at")
  completedAt      DateTime?            @map("completed_at")
  integration      ChallongeIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, startedAt])
  @@index([status, startedAt])
  @@map("challonge_sync_logs")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  requestId   String?  @map("request_id")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model TeamRegistration {
  id                     String                         @id @default(uuid()) @db.Uuid
  tournamentId           String                         @map("tournament_id") @db.Uuid
  userId                 String?                        @map("user_id") @db.Uuid
  savedTeamId            String?                        @map("saved_team_id") @db.Uuid
  entryType              TournamentEntryType            @default(team) @map("entry_type")
  teamName               String                         @map("team_name")
  country                String?
  teamTag                String?                        @map("team_tag")
  organizationRequested  Boolean                        @default(false) @map("organization_requested")
  captainName            String                         @map("captain_name")
  captainEmail           String                         @map("captain_email")
  captainPhone           String                         @map("captain_phone")
  captainDiscord         String                         @map("captain_discord")
  captainRiotId          String                         @map("captain_riot_id")
  contactEmail           String                         @map("contact_email")
  teamLogoName           String?                        @map("team_logo_name")
  status                 TeamRegistrationStatus         @default(pending)
  paymentStatus          RegistrationPaymentStatus      @default(unpaid) @map("payment_status")
  verificationStatus     RegistrationVerificationStatus @default(pending) @map("verification_status")
  rulebookAccepted       Boolean                        @default(false) @map("rulebook_accepted")
  falsityWarningAccepted Boolean                        @default(false) @map("falsity_warning_accepted")
  additionalData         Json                           @default("{}") @map("additional_data")
  assignedSlotNumber     Int?                           @map("assigned_slot_number")
  quotedFeeAmount        Decimal?                       @map("quoted_fee_amount") @db.Decimal(12, 2)
  quotedFeeCurrency      String?                        @map("quoted_fee_currency")
  reservedUntil          DateTime?                      @map("reserved_until")
  createdAt              DateTime                       @default(now()) @map("created_at")
  updatedAt              DateTime                       @updatedAt @map("updated_at")
  tournament             Tournament                     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  savedTeam              SavedTeam?                     @relation(fields: [savedTeamId], references: [id], onDelete: SetNull)
  user                   User?                          @relation(fields: [userId], references: [id], onDelete: SetNull)
  members                RegistrationMember[]
  payments               PaymentTransaction[]
  adminSlotReservation   AdminSlotReservation?
  matchParticipants      MatchParticipant[]
  challongeLinks         ChallongeParticipantLink[]

  @@unique([tournamentId, captainEmail])
  @@index([tournamentId])
  @@index([tournamentId, teamName])
  @@index([savedTeamId])
  @@index([userId, createdAt])
  @@index([reservedUntil])
  @@index([tournamentId, assignedSlotNumber])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, verificationStatus])
  @@map("team_registrations")
}

model AdminSlotReservation {
  id                 String           @id @default(uuid()) @db.Uuid
  tournamentId       String           @map("tournament_id") @db.Uuid
  registrationId     String           @unique @map("registration_id") @db.Uuid
  createdById        String           @map("created_by_id") @db.Uuid
  assignedSlotNumber Int              @map("assigned_slot_number")
  quotedFeeAmount    Decimal          @map("quoted_fee_amount") @db.Decimal(12, 2)
  quotedFeeCurrency  String           @map("quoted_fee_currency")
  note               String?
  createdAt          DateTime         @default(now()) @map("created_at")
  tournament         Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  registration       TeamRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  createdBy          User             @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([tournamentId, assignedSlotNumber])
  @@index([tournamentId])
  @@index([createdById])
  @@map("admin_slot_reservations")
}

model Product {
  id           String           @id @default(uuid()) @db.Uuid
  slug         String           @unique
  name         String
  description  String
  currency     String           @default("LKR")
  status       ProductStatus    @default(draft)
  madeToOrder  Boolean          @default(true) @map("made_to_order")
  displayOrder Int              @default(100) @map("display_order")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  variants     ProductVariant[]
  images       ProductImage[]

  @@index([status, displayOrder])
  @@map("products")
}

model ProductVariant {
  id         String                 @id @default(uuid()) @db.Uuid
  productId  String                 @map("product_id") @db.Uuid
  sku        String                 @unique
  name       String
  size       String?
  color      String?
  price      Decimal                @db.Decimal(12, 2)
  stock      Int?
  isActive   Boolean                @default(true) @map("is_active")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  product    Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems MerchandiseOrderItem[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id           String     @id @default(uuid()) @db.Uuid
  productId    String     @map("product_id") @db.Uuid
  imageAssetId String     @map("image_asset_id") @db.Uuid
  altText      String     @default("") @map("alt_text")
  displayOrder Int        @default(100) @map("display_order")
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageAsset   ImageAsset @relation(fields: [imageAssetId], references: [id], onDelete: Restrict)

  @@unique([productId, imageAssetId])
  @@index([productId, displayOrder])
  @@map("product_images")
}

model MerchandiseOrder {
  id                  String                 @id @default(uuid()) @db.Uuid
  publicToken         String                 @unique @map("public_token")
  userId              String?                @map("user_id") @db.Uuid
  email               String
  firstName           String                 @map("first_name")
  lastName            String                 @map("last_name")
  phone               String
  address             String
  city                String
  country             String                 @default("Sri Lanka")
  currency            String                 @default("LKR")
  subtotal            Decimal                @db.Decimal(12, 2)
  deliveryFee         Decimal                @map("delivery_fee") @db.Decimal(12, 2)
  total               Decimal                @db.Decimal(12, 2)
  status              MerchandiseOrderStatus @default(pending_payment)
  expiresAt           DateTime               @map("expires_at")
  inventoryReleasedAt DateTime?              @map("inventory_released_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  user                User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  items               MerchandiseOrderItem[]
  payments            PaymentTransaction[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@map("merchandise_orders")
}

model MerchandiseOrderItem {
  id          String           @id @default(uuid()) @db.Uuid
  orderId     String           @map("order_id") @db.Uuid
  variantId   String?          @map("variant_id") @db.Uuid
  productName String           @map("product_name")
  variantName String           @map("variant_name")
  sku         String
  unitPrice   Decimal          @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal          @map("line_total") @db.Decimal(12, 2)
  order       MerchandiseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("merchandise_order_items")
}

model PaymentTransaction {
  id                 String                     @id @default(uuid()) @db.Uuid
  purpose            PaymentPurpose
  status             PaymentTransactionStatus   @default(created)
  provider           String                     @default("payhere")
  providerOrderId    String                     @unique @map("provider_order_id")
  providerPaymentId  String?                    @unique @map("provider_payment_id")
  registrationId     String?                    @map("registration_id") @db.Uuid
  merchandiseOrderId String?                    @map("merchandise_order_id") @db.Uuid
  ticketOrderId      String?                    @map("ticket_order_id") @db.Uuid
  amount             Decimal                    @db.Decimal(12, 2)
  currency           String
  method             String?
  statusMessage      String?                    @map("status_message")
  notificationDigest String?                    @map("notification_digest")
  paidAt             DateTime?                  @map("paid_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  reconciledAt       DateTime?                  @map("reconciled_at")
  reconciledById     String?                    @map("reconciled_by_id") @db.Uuid
  reconciliationNote String?                    @map("reconciliation_note")
  providerRefundId   String?                    @map("provider_refund_id")
  registration       TeamRegistration?          @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  merchandiseOrder   MerchandiseOrder?          @relation(fields: [merchandiseOrderId], references: [id], onDelete: Cascade)
  ticketOrder        TicketOrder?               @relation(fields: [ticketOrderId], references: [id], onDelete: Cascade)
  notifications      PaymentNotificationAudit[]
  bankTransferProof  BankTransferProof?
  reconciledBy       User?                      @relation("PaymentReconciler", fields: [reconciledById], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([merchandiseOrderId])
  @@index([ticketOrderId])
  @@index([status, createdAt])
  @@index([reconciledById])
  @@map("payment_transactions")
}

model TicketEvent {
  id                 String            @id @default(uuid()) @db.Uuid
  seriesId           String?           @unique @map("series_id") @db.Uuid
  slug               String            @unique
  title              String
  description        String
  venue              String
  startsAt           DateTime          @map("starts_at")
  salesStartAt       DateTime          @map("sales_start_at")
  salesEndAt         DateTime          @map("sales_end_at")
  status             TicketEventStatus @default(draft)
  capacity           Int
  maxTicketsPerOrder Int               @default(10) @map("max_tickets_per_order")
  currency           String            @default("LKR")
  singlePrice        Decimal           @map("single_price") @db.Decimal(12, 2)
  pairPrice          Decimal           @map("pair_price") @db.Decimal(12, 2)
  paymentMethods     Json              @default("[\"payhere\"]") @map("payment_methods")
  bankTransferReviewMinutes Int        @default(1440) @map("bank_transfer_review_minutes")
  bankName           String?           @map("bank_name")
  bankBranch         String?           @map("bank_branch")
  bankAccountName    String?           @map("bank_account_name")
  bankAccountNumber  String?           @map("bank_account_number")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  series             EventSeries?      @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  orders             TicketOrder[]
  tickets            Ticket[]
  scans              TicketScan[]

  @@index([status, startsAt])
  @@index([salesStartAt, salesEndAt])
  @@map("ticket_events")
}

model TicketOrder {
  id                        String               @id @default(uuid()) @db.Uuid
  publicToken               String               @unique @map("public_token")
  eventId                   String               @map("event_id") @db.Uuid
  userId                    String?              @map("user_id") @db.Uuid
  email                     String
  firstName                 String               @map("first_name")
  lastName                  String               @map("last_name")
  phone                     String
  quantity                  Int
  pairCount                 Int                  @map("pair_count")
  singleCount               Int                  @map("single_count")
  pairPrice                 Decimal              @map("pair_price") @db.Decimal(12, 2)
  singlePrice               Decimal              @map("single_price") @db.Decimal(12, 2)
  currency                  String               @default("LKR")
  total                     Decimal              @db.Decimal(12, 2)
  status                    TicketOrderStatus    @default(pending_payment)
  expiresAt                 DateTime             @map("expires_at")
  capacityReleasedAt        DateTime?            @map("capacity_released_at")
  confirmationEmailQueuedAt DateTime?            @map("confirmation_email_queued_at")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  event                     TicketEvent          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user                      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  tickets                   Ticket[]
  payments                  PaymentTransaction[]

  @@index([eventId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("ticket_orders")
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  ticketNumber  String       @unique @map("ticket_number")
  orderId       String       @map("order_id") @db.Uuid
  eventId       String       @map("event_id") @db.Uuid
  sequence      Int
  tokenVersion  Int          @default(1) @map("token_version")
  status        TicketStatus @default(pending)
  checkedInAt   DateTime?    @map("checked_in_at")
  checkedInById String?      @map("checked_in_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  order         TicketOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event         TicketEvent  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  checkedInBy   User?        @relation("TicketCheckInStaff", fields: [checkedInById], references: [id], onDelete: SetNull)
  scans         TicketScan[]

  @@unique([orderId, sequence])
  @@index([eventId, status])
  @@index([checkedInById])
  @@map("tickets")
}

model TicketScan {
  id          String           @id @default(uuid()) @db.Uuid
  eventId     String?          @map("event_id") @db.Uuid
  ticketId    String?          @map("ticket_id") @db.Uuid
  scannedById String           @map("scanned_by_id") @db.Uuid
  result      TicketScanResult
  detail      String?
  scannedAt   DateTime         @default(now()) @map("scanned_at")
  event       TicketEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  ticket      Ticket?          @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  scannedBy   User             @relation("TicketScanStaff", fields: [scannedById], references: [id], onDelete: Restrict)

  @@index([eventId, scannedAt])
  @@index([ticketId, scannedAt])
  @@index([scannedById, scannedAt])
  @@map("ticket_scans")
}

model BankTransferProof {
  id               String             @id @default(uuid()) @db.Uuid
  transactionId    String             @unique @map("transaction_id") @db.Uuid
  storedFilename   String             @map("stored_filename")
  originalFilename String             @map("original_filename")
  contentType      String             @map("content_type")
  byteSize         Int                @map("byte_size")
  sha256           String             @unique
  submittedAt      DateTime           @default(now()) @map("submitted_at")
  reviewedAt       DateTime?          @map("reviewed_at")
  reviewedById     String?            @map("reviewed_by_id") @db.Uuid
  rejectionReason  String?            @map("rejection_reason")
  transaction      PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewedBy       User?              @relation("PaymentProofReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reviewedById])
  @@index([submittedAt])
  @@map("bank_transfer_proofs")
}

model PaymentNotificationAudit {
  id                 String                   @id @default(uuid()) @db.Uuid
  transactionId      String                   @map("transaction_id") @db.Uuid
  notificationDigest String                   @map("notification_digest")
  providerStatus     String                   @map("provider_status")
  appliedStatus      PaymentTransactionStatus @map("applied_status")
  payload            Json
  createdAt          DateTime                 @default(now()) @map("created_at")
  transaction        PaymentTransaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, createdAt])
  @@index([notificationDigest])
  @@map("payment_notification_audits")
}

model RegistrationMember {
  id                String                 @id @default(uuid()) @db.Uuid
  registrationId    String                 @map("registration_id") @db.Uuid
  userId            String?                @map("user_id") @db.Uuid
  role              RegistrationMemberRole
  memberOrder       Int                    @map("member_order")
  name              String
  email             String?
  emailNormalized   String?                @map("email_normalized")
  discord           String?
  riotId            String?                @map("riot_id")
  additionalData    Json                   @default("{}") @map("additional_data")
  inviteStatus      TeamMemberInviteStatus @default(pending) @map("invite_status")
  inviteTokenHash   String?                @unique @map("invite_token_hash")
  inviteSentAt      DateTime?              @map("invite_sent_at")
  inviteExpiresAt   DateTime?              @map("invite_expires_at")
  inviteRespondedAt DateTime?              @map("invite_responded_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  registration      TeamRegistration       @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([registrationId, role, memberOrder])
  @@index([registrationId])
  @@index([userId])
  @@index([emailNormalized])
  @@index([inviteStatus])
  @@index([inviteExpiresAt])
  @@map("registration_members")
}

model SavedTeam {
  id                    String             @id @default(uuid()) @db.Uuid
  captainUserId         String             @map("captain_user_id") @db.Uuid
  name                  String
  country               String?
  teamTag               String?            @map("team_tag")
  organizationRequested Boolean            @default(false) @map("organization_requested")
  organizationName      String?            @map("organization_name")
  logoName              String?            @map("logo_name")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  captainUser           User               @relation(fields: [captainUserId], references: [id], onDelete: Cascade)
  members               SavedTeamMember[]
  registrations         TeamRegistration[]

  @@unique([captainUserId, name])
  @@index([captainUserId])
  @@index([createdAt])
  @@map("saved_teams")
}

model SavedTeamMember {
  id                String                 @id @default(uuid()) @db.Uuid
  teamId            String                 @map("team_id") @db.Uuid
  userId            String?                @map("user_id") @db.Uuid
  role              RegistrationMemberRole
  memberOrder       Int                    @map("member_order")
  name              String
  email             String
  emailNormalized   String                 @map("email_normalized")
  discord           String?
  riotId            String?                @map("riot_id")
  inviteStatus      TeamMemberInviteStatus @default(pending) @map("invite_status")
  inviteTokenHash   String?                @unique @map("invite_token_hash")
  inviteSentAt      DateTime?              @map("invite_sent_at")
  inviteExpiresAt   DateTime?              @map("invite_expires_at")
  inviteRespondedAt DateTime?              @map("invite_responded_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  team              SavedTeam              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([teamId, role, memberOrder])
  @@unique([teamId, emailNormalized])
  @@index([teamId])
  @@index([userId])
  @@index([emailNormalized])
  @@index([inviteStatus])
  @@map("saved_team_members")
}

model RateLimitBucket {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  key       String
  count     Int      @default(0)
  resetAt   DateTime @map("reset_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, key])
  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model BackgroundJob {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  payload     Json
  dedupeKey   String?             @unique @map("dedupe_key")
  status      BackgroundJobStatus @default(queued)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5) @map("max_attempts")
  availableAt DateTime            @default(now()) @map("available_at")
  lockedAt    DateTime?           @map("locked_at")
  completedAt DateTime?           @map("completed_at")
  failedAt    DateTime?           @map("failed_at")
  lastError   String?             @map("last_error")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([lockedAt])
  @@index([createdAt])
  @@map("background_jobs")
}

model ImageAsset {
  id             String         @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  category       String
  originalName   String?        @map("original_name")
  storedFilename String?        @map("stored_filename")
  contentType    String         @map("content_type")
  byteSize       Int?           @map("byte_size")
  data           Bytes?
  createdAt      DateTime       @default(now()) @map("created_at")
  posters        Poster[]
  productImages  ProductImage[]

  @@index([category, createdAt])
  @@index([createdAt])
  @@map("image_assets")
}

model Poster {
  id           String      @id @default(uuid()) @db.Uuid
  importKey    String?     @unique @map("import_key")
  imageAssetId String      @map("image_asset_id") @db.Uuid
  tournamentId String?     @map("tournament_id") @db.Uuid
  title        String
  description  String?
  category     String      @default("poster")
  headline     String
  subheadline  String?     @map("subheadline")
  accentColor  String      @default("#7c3aed") @map("accent_color")
  textColor    String      @default("#ffffff") @map("text_color")
  overlayAlign String      @default("bottom-left") @map("overlay_align")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  imageAsset   ImageAsset  @relation(fields: [imageAssetId], references: [id], onDelete: Cascade)
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([imageAssetId])
  @@index([tournamentId])
  @@index([category, createdAt])
  @@index([createdAt])
  @@map("posters")
}
