  gameId       String?            @map("game_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  tournament   Tournament?        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  gameRef      Game?              @relation(fields: [gameId], references: [id], onDelete: SetNull)
  maps         VetoMapPoolMap[]
  templates    VetoRoomTemplate[]
  rooms        VetoRoom[]

  @@index([game, isArchived])
  @@index([tournamentId, isArchived])
  @@index([gameId])
  @@map("veto_map_pools")
}

model VetoMapPoolMap {
  poolId       String      @map("pool_id") @db.Uuid
  mapId        String      @map("map_id") @db.Uuid
  displayOrder Int         @default(100) @map("display_order")
  pool         VetoMapPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  map          VetoMap     @relation(fields: [mapId], references: [id], onDelete: Restrict)

  @@id([poolId, mapId])
  @@index([mapId])
  @@map("veto_map_pool_maps")
}

model VetoRulePreset {
  id           String             @id @default(uuid()) @db.Uuid
  tournamentId String?            @map("tournament_id") @db.Uuid
  name         String
  game         String             @default("valorant")
  format       String
  version      Int                @default(1)
  steps        Json
  isBuiltIn    Boolean            @default(false) @map("is_built_in")
  isArchived   Boolean            @default(false) @map("is_archived")
  gameId       String?            @map("game_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  tournament   Tournament?        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  gameRef      Game?              @relation(fields: [gameId], references: [id], onDelete: SetNull)
  templates    VetoRoomTemplate[]
  rooms        VetoRoom[]

  @@index([game, format, isArchived])
  @@index([tournamentId, isArchived])
  @@index([gameId])
  @@map("veto_rule_presets")
}

model VetoRoomTemplate {
  id           String                 @id @default(uuid()) @db.Uuid
  tournamentId String?                @map("tournament_id") @db.Uuid
  mapPoolId    String                 @map("map_pool_id") @db.Uuid
  rulePresetId String                 @map("rule_preset_id") @db.Uuid
  name         String
  format       String
  version      Int                    @default(1)
  settings     Json
  isDefault    Boolean                @default(false) @map("is_default")
  isArchived   Boolean                @default(false) @map("is_archived")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  tournament   Tournament?            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  mapPool      VetoMapPool            @relation(fields: [mapPoolId], references: [id], onDelete: Restrict)
  rulePreset   VetoRulePreset         @relation(fields: [rulePresetId], references: [id], onDelete: Restrict)
  rooms        VetoRoom[]
  defaults     TournamentVetoConfig[]

  @@index([tournamentId, format, isArchived])
  @@map("veto_room_templates")
}

model TournamentVetoConfig {
  tournamentId      String            @id @map("tournament_id") @db.Uuid
  defaultTemplateId String?           @map("default_template_id") @db.Uuid
  settings          Json              @default("{}")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  tournament        Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  defaultTemplate   VetoRoomTemplate? @relation(fields: [defaultTemplateId], references: [id], onDelete: SetNull)

  @@index([defaultTemplateId])
  @@map("tournament_veto_configs")
}

model VetoRoom {
  id                 String                @id @default(uuid()) @db.Uuid
  code               String                @unique
  tournamentId       String?               @map("tournament_id") @db.Uuid
  matchId            String?               @unique @map("match_id") @db.Uuid
  templateId         String?               @map("template_id") @db.Uuid
  mapPoolId          String                @map("map_pool_id") @db.Uuid
  rulePresetId       String                @map("rule_preset_id") @db.Uuid
  title              String
  format             String
  status             VetoRoomStatus        @default(draft)
  controlMode        VetoControlMode       @default(captain_or_link) @map("control_mode")
  teamOrderMethod    VetoTeamOrderMethod   @default(toss) @map("team_order_method")
  tossMethod         VetoTossMethod        @default(digital) @map("toss_method")
  tossCallerSlot     Int                   @default(2) @map("toss_caller_slot")
  tossCall           String?               @map("toss_call")
  tossResult         String?               @map("toss_result")
  tossWinnerSlot     Int?                  @map("toss_winner_slot")
  teamASlot          Int?                  @map("team_a_slot")
  revision           Int                   @default(0)
  currentStep        Int                   @default(0) @map("current_step")
  turnSeconds        Int?                  @map("turn_seconds")
  turnDeadline       DateTime?             @map("turn_deadline")
  viewerEnabled      Boolean               @default(false) @map("viewer_enabled")
  publishResult      Boolean               @default(false) @map("publish_result")
  configSnapshot     Json                  @map("config_snapshot")
  preVetoMatchStatus MatchStatus?          @map("pre_veto_match_status")
  createdById        String?               @map("created_by_id") @db.Uuid
  openedAt           DateTime?             @map("opened_at")
  startedAt          DateTime?             @map("started_at")
  completedAt        DateTime?             @map("completed_at")
  cancelledAt        DateTime?             @map("cancelled_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  tournament         Tournament?           @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  match              Match?                @relation(fields: [matchId], references: [id], onDelete: SetNull)
  template           VetoRoomTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  mapPool            VetoMapPool           @relation(fields: [mapPoolId], references: [id], onDelete: Restrict)
  rulePreset         VetoRulePreset        @relation(fields: [rulePresetId], references: [id], onDelete: Restrict)
  participants       VetoRoomParticipant[]
  actions            VetoRoomAction[]
  grants             VetoAccessGrant[]

  @@index([tournamentId, status, updatedAt])
  @@index([status, updatedAt])
  @@map("veto_rooms")
}

model VetoRoomParticipant {
  id             String            @id @default(uuid()) @db.Uuid
  roomId         String            @map("room_id") @db.Uuid
  slot           Int
  registrationId String?           @map("registration_id") @db.Uuid
  displayName    String            @map("display_name")
  seed           Int?
  accentColor    String            @default("#8b5cf6") @map("accent_color")
  readyAt        DateTime?         @map("ready_at")
  joinedAt       DateTime?         @map("joined_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  room           VetoRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  registration   TeamRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@unique([roomId, slot])
  @@index([registrationId])
  @@map("veto_room_participants")
}

model VetoRoomAction {
  id              String    @id @default(uuid()) @db.Uuid
  roomId          String    @map("room_id") @db.Uuid
  sequence        Int
  kind            String
  actorSlot       Int?      @map("actor_slot")
  mapSlug         String?   @map("map_slug")
  mapName         String?   @map("map_name")
  side            String?
  payload         Json      @default("{}")
  createdById     String?   @map("created_by_id") @db.Uuid
  invalidatedAt   DateTime? @map("invalidated_at")
  invalidatedById String?   @map("invalidated_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  room            VetoRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, invalidatedAt, sequence])
  @@map("veto_room_actions")
}

model VetoAccessGrant {
  id         String         @id @default(uuid()) @db.Uuid
  roomId     String         @map("room_id") @db.Uuid
  role       VetoAccessRole
  tokenHash  String         @unique @map("token_hash")
  expiresAt  DateTime?      @map("expires_at")
  revokedAt  DateTime?      @map("revoked_at")
  lastUsedAt DateTime?      @map("last_used_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  room       VetoRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, role, revokedAt])
  @@index([expiresAt])
  @@map("veto_access_grants")
}

model MatchRoom {
  id            String                @id @default(uuid()) @db.Uuid
  matchId       String                @unique @map("match_id") @db.Uuid
  code          String                @unique
  chatLockedAt  DateTime?             @map("chat_locked_at")
  lastMessageAt DateTime?             @map("last_message_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  match         Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  members       MatchRoomMember[]
  messages      MatchRoomMessage[]
  support       MatchSupportRequest[]
  notifications Notification[]

  @@index([lastMessageAt])
  @@index([createdAt])
  @@map("match_rooms")
}

model MatchRoomMember {
  id                 String              @id @default(uuid()) @db.Uuid
  roomId             String              @map("room_id") @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  teamSlot           Int?                @map("team_slot")
  role               MatchRoomMemberRole
  joinedAt           DateTime            @default(now()) @map("joined_at")
  lastReadAt         DateTime?           @map("last_read_at")
  notificationsMuted Boolean             @default(false) @map("notifications_muted")
  mutedUntil         DateTime?           @map("muted_until")
  room               MatchRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, lastReadAt])
  @@index([roomId, role])
  @@map("match_room_members")
}

model MatchRoomMessage {
  id             String               @id @default(uuid()) @db.Uuid
  roomId         String               @map("room_id") @db.Uuid
  senderUserId   String?              @map("sender_user_id") @db.Uuid
  kind           MatchRoomMessageKind @default(player)
  body           String
  hiddenAt       DateTime?            @map("hidden_at")
  hiddenByUserId String?              @map("hidden_by_user_id") @db.Uuid
  hiddenReason   String?              @map("hidden_reason")
  createdAt      DateTime             @default(now()) @map("created_at")
  room           MatchRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender         User?                @relation("MatchRoomMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  hiddenBy       User?                @relation("MatchRoomMessageModerator", fields: [hiddenByUserId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@index([senderUserId, createdAt])
  @@map("match_room_messages")
}

model MatchSupportRequest {
  id               String                @id @default(uuid()) @db.Uuid
  roomId           String                @map("room_id") @db.Uuid
  openedByUserId   String                @map("opened_by_user_id") @db.Uuid
  subject          String
  status           MatchSupportStatus    @default(open)
  resolvedByUserId String?               @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?             @map("resolved_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  room             MatchRoom             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  openedBy         User                  @relation("MatchSupportRequestOpener", fields: [openedByUserId], references: [id], onDelete: Cascade)
  resolvedBy       User?                 @relation("MatchSupportRequestResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  messages         MatchSupportMessage[]

  @@index([roomId, status, createdAt])
  @@index([openedByUserId, createdAt])
  @@map("match_support_requests")
}

model MatchSupportMessage {
  id           String              @id @default(uuid()) @db.Uuid
  requestId    String              @map("request_id") @db.Uuid
  senderUserId String              @map("sender_user_id") @db.Uuid
  body         String
  createdAt    DateTime            @default(now()) @map("created_at")
  request      MatchSupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([senderUserId, createdAt])
  @@map("match_support_messages")
}

model Notification {
  id          String                  @id @default(uuid()) @db.Uuid
  eventKey    String                  @unique @map("event_key")
  type        String
  title       String
  body        String
  actionUrl   String?                 @map("action_url")
  matchRoomId String?                 @map("match_room_id") @db.Uuid
  expiresAt   DateTime?               @map("expires_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  matchRoom   MatchRoom?              @relation(fields: [matchRoomId], references: [id], onDelete: Cascade)
  recipients  NotificationRecipient[]

  @@index([matchRoomId, createdAt])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationRecipient {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  seenAt         DateTime?    @map("seen_at")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt, createdAt])
  @@map("notification_recipients")
}

model WebPushSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([lastUsedAt])
  @@map("web_push_subscriptions")
}

model UserNotificationPreference {
  userId            String   @id @map("user_id") @db.Uuid
  matchPushEnabled  Boolean  @default(true) @map("match_push_enabled")
  soundEnabled      Boolean  @default(true) @map("sound_enabled")
  matchEmailEnabled Boolean  @default(false) @map("match_email_enabled")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}
