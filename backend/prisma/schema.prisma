// How a Discord account came to be attached to a player. `oauth` means the
// person completed the flow and Discord confirmed the account is theirs.
// `admin` means staff asserted the link — necessary for a LAN entrant who has
// no Quest account, but a materially weaker claim, so the two are never
// collapsed into one boolean.
enum DiscordLinkSource {
  oauth
  admin
}

// A game account is per-title because every title resolves identity through a
// different upstream with a different verification strength. Adding a title is
// an additive enum value plus an adapter, never a new user model.
enum GameAccountGame {
  valorant
}

// Verification says exactly what was PROVEN, never more. There is no Riot
// Sign-On available to Quest — the VALORANT upstream resolves accounts through
// HenrikDev, which proves an account EXISTS but can never prove the signed-in
// Quest user holds it. `ownership_verified` is therefore deliberately absent;
// if RSO ever ships it is a new state, not a rename of one of these.
enum GameAccountVerificationStatus {
  resolved
  user_confirmed
  discord_corroborated
  admin_verified
  legacy_unverified
  revoked
}

// Lifecycle, kept separate from verification: an admin-verified account can
// still be locked by a live tournament, and a replaced account keeps its
// verification history.
// A change request is an admin decision record, not a state of the account.
// Keeping it separate means a rejected request stays visible as history.
enum GameAccountChangeStatus {
  pending
  approved
  rejected
  withdrawn
}

enum GameAccountStatus {
  active
  change_requested
  locked
  replaced
  revoked
}

