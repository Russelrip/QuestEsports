// Quest-owned durable player identity. Separate from `User` on purpose: a
// player may exist before anyone claims them (legacy roster rows, guests at a
// LAN), and one person must survive changing their email, username, Discord,
// or Riot account without losing tournament history.
// Replacing the actual game account behind a competitive identity is an
// audited, admin-reviewed event — never a profile edit. A Riot RENAME is not a
// change: the stable identifier is unchanged, so display fields simply refresh.
// This table exists for the other case, where the underlying account differs.
model GameAccountChangeRequest {
  id                  String                  @id @default(uuid()) @db.Uuid
  playerId            String                  @map("player_id") @db.Uuid
  currentAccountId    String?                 @map("current_account_id") @db.Uuid
  game                GameAccountGame
  requestedExternalId String                  @map("requested_external_id")
  requestedUsername   String?                 @map("requested_username")
  requestedTagline    String?                 @map("requested_tagline")
  requestedRegion     String?                 @map("requested_region")
  reason              String
  status              GameAccountChangeStatus @default(pending)
  requestedByUserId   String?                 @map("requested_by_user_id") @db.Uuid
  reviewedByUserId    String?                 @map("reviewed_by_user_id") @db.Uuid
  reviewedAt          DateTime?               @map("reviewed_at")
  adminNote           String?                 @map("admin_note")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  player              Player                  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  currentAccount      GameAccount?            @relation(fields: [currentAccountId], references: [id], onDelete: SetNull)
  requestedByUser     User?                   @relation("GameAccountChangeRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviewedByUser      User?                   @relation("GameAccountChangeReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([playerId])
  @@map("game_account_change_requests")
}

