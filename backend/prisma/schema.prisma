}

// A player's Discord account, as competitive infrastructure rather than as a
// login.
//
// `OAuthAccount` already stores the snowflake, but it is an AUTHENTICATION
// record: it exists so somebody can sign in, and it cascades away with the user
// row. Tournament operations need the link to outlive that, and need it to
// exist for a player who has no Quest account at all — a LAN entrant a captain
// registered on their behalf can still be the person a referee has to reach.
//
// `discordUserId` is the snowflake and the only identity key. `username` and
// `globalName` are a cached display snapshot exactly like GameAccount's
// username/tagline: Discord names change, snowflakes do not. This repo has
// already shipped two fixes about storing the wrong one, so the distinction is
// enforced by a CHECK constraint rather than left to discipline.
model DiscordIdentity {
  id            String            @id @default(uuid()) @db.Uuid
  playerId      String            @unique @map("player_id") @db.Uuid
  discordUserId String            @unique @map("discord_user_id")
  username      String?
  globalName    String?           @map("global_name")
  source        DiscordLinkSource @default(oauth)
  linkedAt      DateTime          @default(now()) @map("linked_at")
  lastSeenAt    DateTime?         @map("last_seen_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  player        Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // The abuse boundary, mirroring GameAccount's: one Discord account belongs to
  // one player. Without it, two people could claim the same account and a
  // tournament role could be granted to the wrong person.
  @@index([discordUserId])
  @@map("discord_identities")
}

// A player's identity inside one specific game, keyed on the upstream's STABLE
// identifier (PUUID for VALORANT). `username`/`tagline`/`region` are a cached
// display snapshot and are never an identity key — a Riot rename changes them
// while `externalId` stays put.
model GameAccount {
  id                    String                        @id @default(uuid()) @db.Uuid
  playerId              String                        @map("player_id") @db.Uuid
  game                  GameAccountGame
  externalId            String                        @map("external_id")
  username              String?
  tagline               String?
  region                String?
  verificationStatus    GameAccountVerificationStatus @default(resolved) @map("verification_status")
  status                GameAccountStatus             @default(active)
  linkedAt              DateTime                      @default(now()) @map("linked_at")
  verifiedAt            DateTime?                     @map("verified_at")
  lastSyncedAt          DateTime?                     @map("last_synced_at")
  metadata              Json                          @default("{}")
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")
  player                Player                        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  registrationSnapshots RegistrationMember[]
  changeRequests        GameAccountChangeRequest[]

  // The abuse boundary: one Quest player per real game account. A partial
  // unique index in the migration additionally allows only one ACTIVE account
  // per player per game, so a replaced account keeps its history without
  // colliding with its successor.
  @@unique([game, externalId])
  @@index([playerId])
  @@index([game, status])
  @@index([verificationStatus])
  @@map("game_accounts")
}

