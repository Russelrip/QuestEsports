PORT=5001
# Defensive default for legacy server-side date parsing. Tournament inputs are also
# converted explicitly in application code.
TZ=Asia/Colombo
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=10&pool_timeout=10&connect_timeout=10
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Use memory for one local/API process. Use upstash for shared or serverless production caching.
CACHE_DRIVER=memory
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000
CACHE_CONNECTION_TIMEOUT_MS=2000
CACHE_KEY_PREFIX=quest-esports
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LOG_LEVEL=info
SESSION_COOKIE_NAME=quest_session
SESSION_TTL_DAYS=1
REMEMBER_ME_SESSION_TTL_DAYS=30
MFA_ISSUER=Quest E-sports
# Required outside automated tests and must be exactly 64 hexadecimal characters. Generate with: openssl rand -hex 32
AUTH_ENCRYPTION_KEY=
TRUST_PROXY=false
# Leave blank to default to false locally and true in production.
REQUIRE_API_ORIGIN=
JOB_WORKER_ENABLED=true
COMMERCE_MAINTENANCE_ENABLED=true
JOB_WORKER_POLL_MS=5000
JOB_WORKER_MAX_ATTEMPTS=5
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_TOKEN=
# Discord channel webhook for redacted backend exception embeds. Never commit the real URL.
DISCORD_ALERT_WEBHOOK_URL=
# Use "resend" now. Change to "smtp" later for Amazon SES or another SMTP provider.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
# Leave blank to default to false locally and true in production.
# Production requires true plus complete settings for the selected provider.
MAIL_DELIVERY_REQUIRED=
# Only used when MAIL_PROVIDER=smtp. To switch back to Amazon SES Singapore:
# SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your_ses_smtp_username
# SMTP_PASS=your_ses_smtp_password
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5001
# Use a durable mounted path in production, outside disposable release directories.
# Recommended for the Quest Ubuntu VPS: /srv/quest-esports/uploads
UPLOAD_ROOT=
# Private payment evidence must never be served by /api/uploads.
# Recommended for the Quest Ubuntu VPS: /srv/quest-esports/private
PRIVATE_UPLOAD_ROOT=
# Bank-transfer proofs accept screenshot images only: PNG, JPEG, or WebP.
# Reviewed payment evidence is deleted after this retention period.
BANK_TRANSFER_PROOF_RETENTION_DAYS=365
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:5001/api/auth/discord/callback

# PayHere Checkout API. Keep all three credential values blank until PayHere is available.
# If any credential is set, all three are required. Keep sandbox mode until the public notify URL and domain are approved.
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=
SHOP_DELIVERY_FEE_LKR=500
SHOP_ORDER_RESERVATION_MINUTES=30
