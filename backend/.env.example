NODE_ENV=development
PORT=5001
# Defensive default for legacy server-side date parsing. Tournament inputs are also
# converted explicitly in application code.
TZ=Asia/Colombo
CORS_ORIGIN=http://localhost:3000
# All Supabase URLs retain TLS, including a dedicated local test database:
# use sslmode=require, verify-ca, or verify-full. Real credentials live only
# in the untracked backend/.env and are never committed.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&connection_limit=10&pool_timeout=10&connect_timeout=10
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Use memory for one local/API process. Use upstash for shared or serverless production caching.
CACHE_DRIVER=memory
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000
CACHE_CONNECTION_TIMEOUT_MS=2000
CACHE_KEY_PREFIX=quest-esports
# Set to the number of API processes/replicas. Values above 1 require a shared cache.
API_PROCESS_COUNT=1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LOG_LEVEL=info
SESSION_COOKIE_NAME=quest_session
SESSION_TTL_DAYS=1
REMEMBER_ME_SESSION_TTL_DAYS=30
# Required outside automated tests and must be exactly 64 hexadecimal characters. Generate with: openssl rand -hex 32
AUTH_ENCRYPTION_KEY=
TRUST_PROXY=false
# Leave blank to default to false locally and true in production.
REQUIRE_API_ORIGIN=
# Required in production while password authentication and queued email are enabled.
JOB_WORKER_ENABLED=true
COMMERCE_MAINTENANCE_ENABLED=true
SITE_MAINTENANCE_MODE=false
SITE_MAINTENANCE_MESSAGE=We’re carrying out scheduled maintenance. Please try again shortly.
SITE_MAINTENANCE_RETRY_AFTER_SECONDS=900
JOB_WORKER_POLL_MS=5000
JOB_WORKER_MAX_ATTEMPTS=5
# Server-side Challonge synchronization. Leave disabled until real credentials are configured.
CHALLONGE_ENABLED=false
# Keep disabled for the public-embed/write-only model. Manual editor refreshes remain available.
CHALLONGE_AUTOMATIC_SYNC_ENABLED=false
CHALLONGE_CLIENT_ID=
CHALLONGE_CLIENT_SECRET=
CHALLONGE_OAUTH_SCOPE=application:manage
CHALLONGE_TOKEN_URL=https://api.challonge.com/oauth/token
CHALLONGE_BASE_URL=https://api.challonge.com/v2.1
CHALLONGE_BRACKET_CACHE_SECONDS=30
CHALLONGE_REQUEST_TIMEOUT_MS=8000
CHALLONGE_DEFAULT_SYNC_MINUTES=5
CHALLONGE_SYNC_LEASE_SECONDS=90
# Initial SSE broadcaster assumes the current single API process; clients poll as a fallback.
# Disabled by default until a deployment deliberately configures connection limits.
REALTIME_SSE_ENABLED=false
REALTIME_SSE_MAX_CONNECTIONS=100
REALTIME_SSE_MAX_CONNECTIONS_PER_IP=5
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_TOKEN=
# Discord channel webhook for redacted backend exception embeds. Never commit the real URL.
DISCORD_ALERT_WEBHOOK_URL=
# Use "resend" now. Change to "smtp" later for Amazon SES or another SMTP provider.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
# Leave blank to default to false locally and true in production.
# Production requires true plus complete settings for the selected provider.
MAIL_DELIVERY_REQUIRED=
# Only used when MAIL_PROVIDER=smtp. The current SES region is Tokyo:
# SMTP_HOST=email-smtp.ap-northeast-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your_ses_smtp_username
# SMTP_PASS=your_ses_smtp_password
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5001
# Production: https://api.questesports.lk/mobile-admin-oauth (verified Android App Link).
MOBILE_ADMIN_OAUTH_REDIRECT_URL=questadmin://oauth
# Production Android signing certificate SHA-256 fingerprint, colon separated.
MOBILE_ADMIN_ANDROID_CERT_SHA256=
# Use a durable mounted path in production, outside disposable release directories.
# Recommended for the Quest Ubuntu VPS: /srv/quest-esports/uploads
UPLOAD_ROOT=
# Private payment evidence must never be served by /api/uploads.
# Recommended for the Quest Ubuntu VPS: /srv/quest-esports/private
PRIVATE_UPLOAD_ROOT=
# Bank-transfer proofs accept screenshot images only: PNG, JPEG, or WebP.
# Reviewed payment evidence is deleted after this retention period.
BANK_TRANSFER_PROOF_RETENTION_DAYS=365
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:5001/api/auth/discord/callback

# PayHere Checkout API. Keep all three credential values blank until PayHere is available.
# If any credential is set, all three are required. Keep sandbox mode until the public notify URL and domain are approved.
PAYHERE_MODE=sandbox
# A production deployment with PayHere credentials must use live mode unless this is deliberately true.
PAYHERE_ALLOW_SANDBOX_IN_PRODUCTION=false
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=
SHOP_DELIVERY_FEE_LKR=500
SHOP_ORDER_RESERVATION_MINUTES=30
TICKET_ORDER_RESERVATION_MINUTES=30

# VALORANT platform internal service (Quest backend -> valorant-platform-backend).
# Set VALORANT_INTERNAL_BASE_URL to enable the integration. Outside NODE_ENV=test
# it then requires VALORANT_SERVICE_SECRET and VALORANT_SERVICE_KEY_ID, and the
# URL must be HTTPS in production.
VALORANT_INTERNAL_BASE_URL=
VALORANT_SERVICE_SECRET=
VALORANT_SERVICE_KEY_ID=
VALORANT_SERVICE_ISSUER=quest-esports
VALORANT_SERVICE_AUDIENCE=valorant-platform
VALORANT_TIMEOUT_MS=60000
VALORANT_READ_RETRIES=2

# VALORANT SL player leaderboard (Quest backend -> valorantsl-new public API).
# Optional: when unset, the public leaderboard routes return 503 (fail-soft).
VALORANT_SL_API_URL=
# System actor used to sign service-token requests to valorant-platform-backend.
# Optional: when unset, the public leaderboard routes return 503 (fail-soft).
QUEST_LEADERBOARD_SYSTEM_ACTOR=
