{
  "name": "backend",
  "version": "1.0.0",
  "description": "Quest Esports API rebuilt from scratch",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "lint": "eslint src tests scripts",
    "test": "node --test",
    "test:integration": "node --test tests/database-integration.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-exclude=src/generated/** --test-coverage-lines=68 --test-coverage-branches=60 --test-coverage-functions=68",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrations:check-pending": "node scripts/check-pending-migrations.js",
    "prisma:security:verify": "node scripts/verify-database-security.js",
    "prisma:studio": "prisma studio",
    "mail:verify": "node scripts/verify-mail-config.js",
    "media:import-legacy-posters": "node scripts/import-legacy-posters.js",
    "media:migrate-image-assets": "node scripts/migrate-image-assets.js",
    "media:optimize-tournament-banners": "node scripts/optimize-tournament-banners.js",
    "load:test": "k6 run performance/k6-api.js",
    "load:stress:db": "k6 run performance/k6-db-stress.js",
    "alerts:test:discord": "node scripts/verify-discord-alert.js",
    "data:copy-public-to-staging": "node scripts/copy-public-data-to-staging.js",
    "data:copy-public-to-staging:apply": "node scripts/copy-public-data-to-staging.js --apply",
    "data:copy-public-to-staging:prune": "node scripts/copy-public-data-to-staging.js --apply --prune"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "brackets-manager": "^1.11.0",
    "brackets-model": "^1.7.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "read-excel-file": "^9.0.10",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "path-to-regexp": "8.4.2",
    "picomatch": "2.3.2",
    "qs": "6.15.2",
    "uuid": "11.1.1"
  }
}
