[Unit]
Description=VALORANT weekly name audit (Compose one-shot from the current release)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# Runs against the release bundle `current` points at, the same Compose file and
# approved image digest the release admitted. The audit takes the release lock
# itself and skips if a release holds it.
ExecStart=/usr/bin/bash -eu -c 'bundle="$$(readlink -f /opt/quest-esports/current)"; case "$$bundle" in /opt/quest-esports/releases/*) ;; *) echo "current release bundle is not under /opt/quest-esports/releases" >&2; exit 1 ;; esac; exec /usr/bin/docker compose --env-file "$$bundle/.env" -f "$$bundle/valorant.compose.yml" --project-name valorant-prod run --rm --no-deps valorant-name-audit'
TimeoutStartSec=3h
