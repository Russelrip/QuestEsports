# VALORANT Platform Backend — environment template (committed; the real .env is
# never committed — see .gitignore). Copy to `.env` and fill in the secrets:
#   cp .env.example .env
# Every value is also a `Settings` field in app/config.py (pydantic-settings);
# unset variables fall back to the defaults below, so `.env` only needs the
# values you actually override.

# Runtime environment: development | local | test | production
# `require_admin` is bypassed ONLY in `local`/`test`; `production` (and any
# other value) enforces the X-Admin-Key header on every mutation/discovery route.
APP_ENV=development

# Application database (asyncpg driver; SQLAlchemy async). Local default below.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/valorant_platform
VALORANT_DATABASE_SSL_VERIFY=off
VALORANT_DATABASE_SSL_CA_FILE=
VALORANT_DATABASE_SSL_SERVER_HOSTNAME=

# HenrikDev API key. NEVER commit a real key; keep it out of logs (the client
# never logs it). Leave empty to run the full offline suite (fixtures only).
HENRIK_API_KEY=
HENRIK_BASE_URL=https://api.henrikdev.xyz
# Runtime auth form is pinned by app/integrations/henrik/contract.py
# (AUTH_SCHEME_PINNED = "bare" until a live probe confirms Bearer); this
# setting is retained for operational visibility only.
HENRIK_AUTH_SCHEME=bare
# Per-request HTTP timeout (seconds) — the security baseline requires it set.
HENRIK_TIMEOUT_SECONDS=15
# Bounded exponential retries for transient upstream failures only.
HENRIK_MAX_RETRIES=2
# Cap (seconds) applied to the server-controlled Retry-After wait on 429.
HENRIK_RETRY_AFTER_CAP_SECONDS=30

# Defaults for player resolution / match search / team seeding.
DEFAULT_PLATFORM=pc
DEFAULT_AFFINITY=eu
DEFAULT_INITIAL_ELO=1000

# Hard bounds for two-player match search (also enforced in code).
MATCH_SEARCH_MAX_PAGE_SIZE=50
MATCH_SEARCH_MAX_PAGES=5

# Admin token required (outside local/test) on all POST/PATCH/DELETE routes and
# on Henrik-consuming discovery (resolve / two-player / import). Compare is
# constant-time (secrets.compare_digest). Leave empty + APP_ENV=production to
# deny every admin route.
ADMIN_API_KEY=

# Quest service-token (HMAC bearer) verification (integration delta D1).
# Format: "kid1=secret1,kid2=secret2" — kid selects the shared secret so
# rotation keeps a dual-key overlap window. Production requires at least one.
QUEST_SERVICE_SHARED_SECRETS=
QUEST_SERVICE_ISSUER=quest-esports
QUEST_SERVICE_AUDIENCE=valorant-platform
SERVICE_TOKEN_MAX_SKEW_SECONDS=30

# Echo the retained raw upstream payloads in match-detail/library responses.
# Off by default (design §14.3): raw payloads are stored but NOT exposed unless
# explicitly opted in.
RAW_PAYLOAD_IN_RESPONSES=false

LOG_LEVEL=INFO

# TEST DATABASE — TEST-DATABASE-ONLY, not a `Settings` field: the app never
# reads this. It is consumed by tests/integration/conftest.py, which creates a
# fresh isolated schema per session (all 0001–0013 applied there) and truncates
# between tests. The CI workflow sets it against a Postgres 16 service container.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/valorant_platform_test

# VAL DML runtime role (four-role model, deployment). The migration runner
# grants schema/table/sequence access and per-table RLS policies to this role;
# the running app should connect as it in production. Leave empty to run as the
# migrator (development/test default).
DATABASE_RUNTIME_ROLE=
