{
  "expo": {
    "name": "Quest Admin",
    "slug": "quest-admin",
    "scheme": "questadmin",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07060b",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "lk.questesports.admin",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#07060b",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.questesports.lk",
              "pathPrefix": "/mobile-admin-oauth"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "./plugins/withAndroidReleaseSigning",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Quest Admin to scan event ticket QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
